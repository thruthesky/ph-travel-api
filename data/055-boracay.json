                    { "time": "점심", "children": [{ "text": "투어 중 해변 바비큐 또는 디 탈리파파 시장에서 해산물 파루토" }] },
                    { "time": "오후", "children": [{ "text": "숙소 수영장 또는 해변 휴식, 마사지" }] },
                    { "time": "오후 5시", "children": [{ "text": "파라우 선셋 세일링" }] }
