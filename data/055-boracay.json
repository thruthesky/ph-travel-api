                    { "time": "오전 7시", "children": [{ "text": "루호산 전망대 방문" }] },
                    { "time": "오전 10시", "children": [{ "text": "불라복 비치 카이트서핑 구경 또는 강습" }] },
                    { "time": "오후", "children": [{ "text": "헬멧 다이빙·패러세일링 등 액티비티" }] },
                    { "time": "저녁", "children": [{ "text": "스테이션 2 라이브 음악 바" }] }
