                    },
                    { "time": "오후 3시", "children": [{ "text": "숙소 체크인 후 화이트 비치 산책" }] },
                    { "time": "오후 5시 30분", "children": [{ "text": "스테이션 1 해변에서 일몰 감상" }] },
                    { "time": "저녁", "children": [{ "text": "디몰 주변 식당에서 저녁, 해변 산책" }] }
