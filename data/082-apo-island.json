                    },
                    { "time": "08:30", "children": [{ "text": "첫 번째 스노클링 — 거북이 구역(가이드 동행)" }] },
                    { "time": "10:30", "children": [{ "text": "두 번째 스노클링 또는 다이빙 — 산호 정원" }] },
                    { "time": "12:00", "children": [{ "text": "섬 식당 또는 투어 도시락으로 점심" }] },
                    { "time": "13:00", "children": [{ "text": "등대 전망대 트레킹과 마을 산책" }] },
                    { "time": "14:30", "children": [{ "text": "섬 출발, 오후 바람이 강해지기 전에 복귀" }] },
                    { "time": "15:30", "children": [{ "text": "말라타파이 도착, 다우인 해변에서 휴식" }] }
                  ]
