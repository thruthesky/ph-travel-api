      "icon": "directions",
      "blocks": [
        {
          "type": "accordion",
          "items": [
            {
              "title": "By bus from Cebu City",
              "icon": "directions_bus",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    {
                      "children": [
                        {
                          "text": "Wikivoyage says the yellow Ceres Liner bus from the South Bus Terminal in Cebu City takes about "
                        },
                        {
                          "type": "duration",
                          "text": "4 hours"
                        },
                        {
                          "text": "."
                        }
                      ]
                    },
                    {
                      "children": [
                        {
                          "text": "Fares were "
                        },
                        {
                          "type": "price",
                          "text": "₱115"
                        },
                        {
                          "text": " for the non-air-conditioned bus and "
                        },
                        {
                          "type": "price",
                          "text": "₱156"
                        },
                        {
                          "text": " for the air-conditioned one (2019 record). Check current fares locally."
                        }
                      ]
                    },
                    {
                      "children": [
                        {
                          "text": "The bus drops you off just past the Moalboal market. From there, take a tricycle about "
                        },
                        {
                          "type": "distance",
                          "text": "3.5km"
                        },
                        {
                          "text": " to Panagsama."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "children": [
                    {
                      "text": "Ticket collectors are reported to overcharge sometimes. Confirm the fare before boarding, carry small change, and pay early."
                    }
                  ]
                }
              ]
            },
            {
              "title": "Van and taxi",
              "icon": "airport_shuttle",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    {
                      "children": [
                        {
                          "text": "Hiring a whole van is quoted at around "
                        },
                        {
                          "type": "price",
                          "text": "₱2,500"
                        },
                        {
                          "text": " for about "
                        },
                        {
                          "type": "duration",
                          "text": "2 hours 30 minutes"
                        },
                        {
                          "text": ". It is expensive for one or two people but realistic for a group."
                        }
                      ]
                    },
                    {
                      "children": [
                        {
                          "text": "One traveler also reports a fixed taxi fare of "
                        },
                        {
                          "type": "price",
                          "text": "₱2,500"
                        },
                        {
                          "text": " from Cebu airport (2018)."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
