            [
              "3~5월",
              "덥고 건조함",
              "물놀이는 좋지만 한낮 햇볕이 강해 자외선 차단 필수, 성주간은 초성수기"
            ],
            [
              "6~10월",
              "비와 파도가 잦음",
              "워터스포츠 제한 가능, 객실 요금이 낮은 비수기"
