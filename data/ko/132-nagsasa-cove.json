                    { "time": "08:00", "children": [{ "text": "아침 식사, 텐트 정리와 쓰레기 수거" }] },
                    { "time": "09:30", "children": [{ "text": "보트로 출발, 아나왕인·카마라 섬·카포네스 섬 호핑" }] },
                    { "time": "12:30", "children": [{ "text": "푼다킷 복귀, 샤워 후 점심" }] },
                    { "time": "14:00", "children": [{ "text": "산 안토니오에서 마닐라행 버스 탑승" }] }
                  ]
