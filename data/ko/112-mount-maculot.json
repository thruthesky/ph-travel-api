                    { "time": "07:30", "children": [{ "text": "점프오프에서 숲길 산행 시작" }] },
                    { "time": "09:30", "children": [{ "text": "캠프 사이트를 지나 록키스 도착, 탈 호수 전망" }] },
                    { "time": "11:30", "children": [{ "text": "로프 구간을 지나 정상 도착, 점심" }] },
                    { "time": "13:00", "children": [{ "text": "그로토 방향으로 하산, 성모 동굴 참배" }] },
                    { "time": "15:00", "children": [{ "text": "마을로 하산 완료, 로미로 늦은 점심" }] }
                  ]
