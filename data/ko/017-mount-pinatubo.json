                    },
                    { "time": "05:30~06:00", "children": [{ "text": "4x4 출발 (등록 마감 시간 전 도착 필수)" }] },
                    { "time": "07:00", "children": [{ "text": "트레킹 시작" }] },
                    { "time": "09:00", "children": [{ "text": "분화구 전망대 도착, 호수 감상과 휴식, 간식" }] },
                    { "time": "10:00", "children": [{ "text": "하산 트레킹" }] },
