            { "label": "바세이–방문자 센터 트라이시클", "price": "편도 약 ₱100~150", "note": "왕복 대절 시 흥정" },
            { "label": "공원 입장료", "price": "약 ₱25~200", "note": "내국인·외국인 요금 다름" },
