                    { "text": ", " },
                    { "type": "duration", "text": "30분~1시간 30분" },
                    { "text": "이 걸리며 요금은 약 " },
                    { "type": "price", "text": "₱350~650" },
                    { "text": "입니다. 마카티·BGC에서는 약 " },
