                    { "type": "duration", "text": "1시간 20분" },
                    { "text": "입니다. 공항에서 알로나 비치까지 차로 약 " },
                    { "type": "duration", "text": "15~20분" },
                    { "text": "입니다." }
                  ]
                }
              ]
            },
