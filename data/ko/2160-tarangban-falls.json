      "icon": "event_note",
      "blocks": [
        {
          "type": "tabs",
          "items": [
            {
              "title": "칼바요그 시내 출발 당일치기",
              "subtitle": "아침 일찍 출발해 타랑반과 방곤 폭포",
              "blocks": [
                {
                  "type": "stepper",
                  "items": [
