                    { "time": "06:00", "children": [{ "text": "해변 아침 산책과 수영" }] },
                    { "time": "08:30", "children": [{ "text": "아침 식사 후 체크아웃" }] },
                    { "time": "09:30", "children": [{ "text": "맹그로브 숲 보호 공원 산책" }] },
                    { "time": "11:00", "children": [{ "text": "칼라타간 시내와 성당 둘러보기" }] },
                    { "time": "12:00", "children": [{ "text": "점심 후 마닐라로 출발 (타가이타이에서 쉬어 가기 좋음)" }] }
                  ]
                },
