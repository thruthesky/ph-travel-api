                    { "time": "10:00", "children": [{ "text": "원더풀 동굴 관람" }] },
                    { "time": "11:30", "children": [{ "text": "볼리나오 1번 폭포와 2번 폭포에서 물놀이" }] },
                    { "time": "13:30", "children": [{ "text": "시내에서 점심, 성 야고보 성당 둘러보기" }] },
                    { "time": "15:00", "children": [{ "text": "발링가사이 강 크루즈 또는 대왕조개 스노클링" }] },
                    { "time": "17:30", "children": [{ "text": "숙소로 돌아와 휴식" }] }
