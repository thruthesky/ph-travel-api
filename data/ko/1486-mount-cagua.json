              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    {
                      "children": [
                        {
                          "text": "마닐라에서 투게가라오(TUG)까지 약 "
                        },
                        {
                          "type": "duration",
                          "text": "1시간 15분"
                        },
