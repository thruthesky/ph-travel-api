                    { "time": "정오", "children": [{ "text": "하로의 오래된 제과점에서 비스코초 등 간식 구입" }] },
                    { "time": "오후 2시", "children": [{ "text": "몰로 성당과 몰로 광장, 판싯 몰로로 늦은 점심" }] },
                    { "time": "오후 4시", "children": [{ "text": "칼레 레알 헤리티지 거리 산책, 박물관 관람" }] },
                    { "time": "오후 6시", "children": [{ "text": "일로일로 강 에스플라나데에서 일몰 산책" }] },
                    { "time": "저녁", "children": [{ "text": "만두리아오 지역 식당가에서 해산물이나 치킨 이나살" }] }
