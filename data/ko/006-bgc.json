              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    {
                      "time": "09:00",
                      "children": [
                        { "text": "마인드 뮤지엄 입장 (약 " },
                        { "type": "duration", "text": "2~3시간" },
                        { "text": ", 화~일 운영)" }
                      ]
                    },
                    { "time": "12:00", "children": [{ "text": "하이 스트리트에서 점심" }] },
                    { "time": "13:30", "children": [{ "text": "하이 스트리트 공원 산책과 벽화 찾기" }] },
                    {
