            { "label": "클락·앙헬레스–베티스 그랩", "price": "편도 약 ₱800~1,500", "note": "시간대와 수요에 따라 변동" },
            { "label": "기사 포함 차량 대절", "price": "하루 약 ₱3,500~6,000", "note": "마닐라 출발, 업체별로 다름" },
            { "label": "점심 식사", "price": "1끼 약 ₱150~400", "note": "과과 시내 팜팡가 음식점, 할로할로 포함" }
