              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    { "time": "07:00", "children": [{ "text": "세부시티에서 차량으로 출발" }] },
                    { "time": "08:30~10:30", "children": [{ "text": "시말라 성지 참배와 정원 산책" }] },
                    { "time": "11:00~12:00", "children": [{ "text": "카르카르 도착, 성 카타리나 성당과 유산 광장" }] },
                    { "time": "12:00~13:00", "children": [{ "text": "레촌 점심" }] },
                    { "time": "13:00~14:30", "children": [{ "text": "옛 저택 골목과 신발 가게, 치차론 쇼핑" }] },
                    { "time": "15:00", "children": [{ "text": "세부시티 귀환 (오후 교통 체증 대비)" }] }
                  ]
                },
                {
                  "type": "paragraph",
