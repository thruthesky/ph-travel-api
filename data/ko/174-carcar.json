                    },
                    { "time": "12:30", "children": [{ "text": "공설시장에서 레촌과 푸소로 점심, 치차론과 암파우 쇼핑" }] },
                    { "time": "14:00", "children": [{ "text": "세부시티로 돌아가거나 시말라 성지·남부 방면으로 이동" }] }
                  ]
                }
