    {
      "type": "section",
      "key": "getting_there",
      "title": "가는 방법",
      "icon": "directions",
      "blocks": [
        {
          "type": "accordion",
          "items": [
            {
              "title": "비행기와 페리",
              "icon": "flight",
              "blocks": [
                {
                  "type": "paragraph",
                  "children": [
