          "blocks": [
            {
              "type": "card",
              "number": 1,
              "title": "1912년에 시작된 공설시장",
              "children": [
                {
                  "text": "이 시장은 기록상 "
                },
                {
                  "type": "date",
                  "text": "1912년 1월 15일"
