                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "key": "getting_there",
      "title": "가는 방법",
      "icon": "directions",
      "blocks": [
        {
          "type": "accordion",
          "items": [
            {
              "title": "경전철(LRT)",
              "icon": "train",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    {
                      "children": [
                        {
                          "text": "가장 편한 방법은 LRT 1호선 카리에도(Carriedo)역입니다. 역에서 카리에도 거리를 따라 성당까지 도보 약 "
                        },
                        { "type": "duration", "text": "5~10분" },
                        { "text": "이며, 요금은 출발역에 따라 약 " },
                        { "type": "price", "text": "₱15~40" },
                        { "text": "입니다. 파사이의 에드사역·바클라란역에서 약 " },
                        { "type": "duration", "text": "25~30분" },
                        { "text": " 걸립니다." }
                      ]
                    },
                    {
                      "children": [
                        { "text": "LRT 2호선 레크토(Recto)역에서도 걸어갈 수 있지만 도보 약 " },
                        { "type": "duration", "text": "15~20분" },
                        { "text": "이 걸리고 인파가 많은 길을 지나야 합니다." }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "title": "그랩·택시",
              "icon": "local_taxi",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    {
                      "children": [
                        { "text": "니노이 아키노 국제공항에서 약 " },
                        { "type": "distance", "text": "13km" },
                        { "text": ", 교통 상황에 따라 " },
                        { "type": "duration", "text": "40분~1시간 30분" },
                        { "text": "이 걸리며 요금은 약 " },
                        { "type": "price", "text": "₱350~650" },
                        { "text": "입니다. 마카티에서는 약 " },
                        { "type": "price", "text": "₱300~500" },
                        { "text": " 수준입니다." }
                      ]
                    },
                    {
                      "children": [
                        {
                          "text": "금요일과 축일에는 성당 주변 도로가 통제되거나 극심하게 막힙니다. 목적지를 'Quiapo Church'로 입력하되, 차가 막히면 케손 대로나 레크토 거리에서 내려 걷는 편이 빠릅니다."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "title": "지프니",
              "icon": "airport_shuttle",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    {
                      "children": [
                        {
