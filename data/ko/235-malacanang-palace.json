          "icon": "calendar_month",
          "columns": ["시기", "날씨", "여행 포인트"],
          "rows": [
            ["11월~2월", "건기, 12월~2월 비교적 선선함", "맨션 관람과 주변 성당 도보 코스에 가장 좋음 — 연말 공휴일 휴관 확인"],
            ["3월~5월", "건기, 매우 덥고 건조(35℃ 안팎)", "오전 회차 위주 — 성주간 휴관일 확인"],
            ["6월~10월", "우기, 소나기와 태풍", "비 오는 날 실내 대안으로 좋음 — 태풍 때는 휴관·도로 침수 대비"]
          ]
        }
      ]
