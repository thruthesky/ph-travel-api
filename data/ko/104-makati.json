                    },
                    { "time": "12:30", "children": [{ "text": "그린벨트에서 필리핀 요리로 점심" }] },
                    { "time": "14:00", "children": [{ "text": "그린벨트·글로리에타·원 아얄라 쇼핑, 더위 피하기" }] },
                    { "time": "16:30", "children": [{ "text": "호텔에서 휴식 또는 스파·마사지" }] },
                    { "time": "18:30", "children": [{ "text": "포블라시온으로 이동해 골목 맛집에서 저녁" }] },
                    { "time": "20:30", "children": [{ "text": "루프톱 바에서 마카티 야경 감상" }] }
