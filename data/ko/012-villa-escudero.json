            },
            { "label": "마닐라~입구 버스", "price": "편도 약 ₱200~300", "note": "루세나행 버스" },
            { "label": "자가용 톨게이트", "price": "편도 약 ₱250~400", "note": "SLEX·STAR 경유" },
