                    },
                    { "time": "13:00", "children": [{ "text": "필리핀 문화 공연 관람 (공연 시간은 당일 안내 확인)" }] },
                    { "time": "14:00", "children": [{ "text": "수영장에서 휴식" }] },
                    { "time": "15:30", "children": [{ "text": "출발, 산 파블로에서 부코 파이 구매" }] },
