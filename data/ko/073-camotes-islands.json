                    { "time": "저녁", "children": [{ "text": "해변 식당에서 저녁, 일몰 감상" }] }
                  ]
                }
              ]
            },
            {
              "title": "2일차",
              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    { "time": "오전 8시", "children": [{ "text": "오토바이 대여 후 다나오 호수 방문, 뗏목 체험" }] },
                    { "time": "오전 11시", "children": [{ "text": "티무보 동굴 수영" }] },
