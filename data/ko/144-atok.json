              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    { "time": "05:00", "children": [{ "text": "바기오에서 차량 대절 또는 북쪽행 버스로 출발" }] },
                    {
                      "time": "06:30~08:30",
