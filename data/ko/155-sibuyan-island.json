                    },
                    { "type": "duration", "text": "1시간 30분~2시간" },
                    { "text": ", 요금은 약 " },
                    { "type": "price", "text": "₱200~400" },
                    { "text": "입니다. 롬블론 섬 관광과 묶기 좋은 경로입니다." }
                  ]
                }
              ]
            },
            {
              "title": "비행기와 배",
              "icon": "flight",
              "blocks": [
                {
                  "type": "paragraph",
                  "children": [
