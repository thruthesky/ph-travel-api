            { "type": "temperature", "text": "33~35℃" },
            { "text": "까지 오르고 계단 구간에 그늘이 적으니 " },
            { "type": "time", "text": "오전 10시" },
            { "text": " 이전이나 " },
            { "type": "time", "text": "오후 3시" },
