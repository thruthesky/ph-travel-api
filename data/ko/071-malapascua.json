                    },
                    { "time": "오후 5시", "children": [{ "text": "선셋 다이빙(만다린피시) 또는 해변 산책" }] },
                    { "time": "저녁", "children": [{ "text": "로그온 마을 쪽 현지 식당 탐방" }] }
