                    { "time": "12:00", "children": [{ "text": "카말리그 피낭앗으로 점심" }] },
                    { "time": "13:30", "children": [{ "text": "레가스피 복귀, 기념품(필리 너트 과자) 구입" }] },
                    { "time": "15:00", "children": [{ "text": "비콜 국제공항으로 이동해 마닐라행 항공편 탑승" }] }
