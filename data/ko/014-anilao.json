                    },
                    { "time": "08:00", "children": [{ "text": "아침 식사 후 오전 보트 다이빙 2회" }] },
                    { "time": "12:00", "children": [{ "text": "점심, 장비 세척과 체크아웃" }] },
                    { "time": "14:00", "children": [{ "text": "마닐라 출발" }] },
                    { "time": "17:00~18:00", "children": [{ "text": "마닐라 도착" }] }
                  ]
                }
