    {
      "type": "section",
      "key": "best_time",
      "title": "여행 최적기와 날씨",
      "icon": "wb_sunny",
      "blocks": [
        {
          "type": "paragraph",
          "children": [
            { "text": "비가 적고 하늘이 맑은 " },
            { "type": "date", "text": "12월" },
            { "text": "부터 " },
            { "type": "date", "text": "5월" },
