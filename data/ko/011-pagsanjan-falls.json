                    },
                    { "time": "08:30", "children": [{ "text": "방카 출발, 협곡 여울을 거슬러 올라가기" }] },
                    { "time": "10:00", "children": [{ "text": "폭포 도착, 대나무 뗏목으로 동굴 체험 후 휴식" }] },
                    { "time": "11:00", "children": [{ "text": "하류로 내려오기" }] },
