                    { "time": "08:30", "children": [{ "text": "아침 식사 후 히든 가든 방문" }] },
                    { "time": "10:30", "children": [{ "text": "아벨 이로코(일로코스 전통 직물) 가게와 기념품 쇼핑" }] },
