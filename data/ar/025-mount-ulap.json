    {
      "type": "section",
      "key": "getting_there",
      "title": "كيفية الوصول",
      "icon": "directions",
      "blocks": [
        {
          "type": "accordion",
          "items": [
            {
              "title": "من مانيلا إلى باغيو",
              "icon": "route",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    {
                      "children": [
                        {
                          "text": "من كوباو وباساي وغيرهما بحافلة متجهة إلى باغيو (فيكتوري لاينر وجوي باص وسوليد نورث وغيرها) نحو "
                        },
                        { "type": "duration", "text": "4–6 ساعات" },
                        { "text": " بأجرة نحو " },
                        { "type": "price", "text": "₱650–1,600" },
                        {
                          "text": ". ولأجل التسلق فجرًا يُنصح بالوصول إلى باغيو في اليوم السابق والمبيت ليلة."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "title": "من باغيو إلى أمبوكاو",
              "icon": "route",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    {
                      "children": [
                        {
                          "text": "من موقف الجيبني المتجه نحو منجم فيليكس في وسط باغيو، استقل جيبني متجهًا إلى فيليكس وانزل عند \"قاعة بارانغاي أمبوكاو\". تستغرق الرحلة نحو "
                        },
                        { "type": "duration", "text": "40 دقيقة–ساعة" },
                        { "text": "، وتبلغ الأجرة نحو " },
                        { "type": "price", "text": "₱40–60" },
                        {
                          "text": " للشخص الواحد. قد لا يكون موعد أول رحلة مبكرًا، لذا تحقق منه في الموقف في اليوم السابق."
                        }
                      ]
                    },
                    {
                      "children": [
                        {
                          "text": "إذا كانت معك مجموعة، فسيارة الأجرة أو الحافلة الصغيرة المستأجرة خيار مريح. تستغرق الرحلة بسيارة الأجرة نحو "
                        },
                        { "type": "duration", "text": "30–45 دقيقة" },
                        {
                          "text": "، ويُفضَّل التفاوض على أن ينتظرك السائق عند مخرج سانتا في ويعيدك."
                        }
                      ]
                    },
                    {
                      "children": [
                        {
                          "text": "تقع محطة الجيبني في شارع لاكاندولا (جهة شارع ماغسايساي) بجوار باغيو سنتر مول، وإذا قلت للسائق إنك ذاهب إلى جبل أولاب أنزلك أمام قاعة باراناغاي أمبوكاو. يبدأ التسجيل من "
                        },
                        { "type": "time", "text": "4:00 فجرًا" },
                        { "text": " في عطلات نهاية الأسبوع ومن " },
                        { "type": "time", "text": "5:00 صباحًا" },
                        { "text": " في أيام الأسبوع، وينتهي عند " },
                        { "type": "time", "text": "14:00" },
                        {
                          "text": "، فاحرص على الوصول في الصباح على أبعد تقدير. وتسير الجيبنيات بين أمبوكاو وباغيو حتى نحو "
                        },
                        { "type": "time", "text": "17:00" },
                        { "text": "." }
                      ]
                    }
                  ]
                }
              ]
            },
            {
