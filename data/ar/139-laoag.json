                        { "type": "duration", "text": "ساعتين" },
                        { "text": "، ومن باغودبود جنوبًا نحو " },
                        { "type": "duration", "text": "ساعتين–ساعتين و30 دقيقة" },
                        { "text": "." }
                      ]
                    }
                  ]
