        {
          "type": "paragraph",
          "children": [
            { "text": "الموسم الجاف من " },
            { "type": "date", "text": "ديسمبر" },
            { "text": " إلى " },
            { "type": "date", "text": "مايو" },
            { "text": " هو الأنسب للتجول حول الجزيرة والأنشطة الشاطئية. وخاصة من " },
            { "type": "date", "text": "مارس" },
            { "text": " إلى " },
            { "type": "date", "text": "مايو" },
            { "text": "، ذروة حصاد المانجو، حين يمكن تذوق ألذ المانجو بأرخص الأسعار. وفي " },
            { "type": "date", "text": "أواخر مايو" },
            {
              "text": "، في حدود ذكرى تأسيس المقاطعة، يُقام مهرجان مانغاهان بفعاليات متتالية مثل مسابقة أكل المانجو والمواكب ومعارض المنتجات الزراعية."
            }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            { "text": "من " },
            { "text": "يونيو", "type": "date" },
            { "text": " إلى " },
