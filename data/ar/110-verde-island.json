    {
      "type": "section",
      "key": "getting_there",
      "title": "كيفية الوصول",
      "icon": "directions",
      "blocks": [
        {
          "type": "accordion",
          "items": [
            {
              "title": "الحافلة",
              "icon": "directions_bus",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    {
                      "children": [
                        {
                          "text": "تسير حافلات من كوباو وبوينديا وPITX في مانيلا إلى ميناء باتانغاس (الرصيف). ويستغرق نحو "
                        },
                        { "type": "duration", "text": "2–3 ساعات" },
                        { "text": " وتبلغ الأجرة نحو " },
                        { "type": "price", "text": "₱250–350" },
                        {
                          "text": ". ويركب الغواصون المتجهون إلى بويرتو غاليرا القارب من الميناء نفسه."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "title": "القارب — ميناء تابانغاو",
              "icon": "directions_boat",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    {
                      "children": [
                        {
                          "text": "ينطلق القارب العام للسكان ليس من ميناء باتانغاس بل من ميناء تابانغاو (تابانغاو أبلايا) في مدينة باتانغاس مرة واحدة يوميًا، ويستغرق الوصول إلى الجزيرة نحو "
                        },
                        { "type": "duration", "text": "ساعة و30 دقيقة" },
                        { "text": ". وينطلق عادة عند امتلائه بالركاب نحو " },
                        { "type": "time", "text": "9 صباحًا" },
                        { "text": "، أما القارب الخارج من الجزيرة فينطلق " },
                        { "type": "time", "text": "4 فجرًا" },
                        {
                          "text": " في اليوم التالي، فلا يمكن الذهاب والعودة في اليوم نفسه بالقارب العام. والأجرة نحو "
                        },
                        { "type": "price", "text": "₱150–250" },
                        { "text": " للاتجاه الواحد." }
                      ]
                    },
                    {
                      "children": [
                        {
                          "text": "ويمكن الوصول إلى ميناء تابانغاو من المحطة الكبرى في باتانغاس بجيبني إلى باغونغ بالينكي (السوق الجديد) بنحو "
                        },
                        { "type": "price", "text": "₱14" },
                        { "text": "، ثم بجيبني متجه إلى تابانغاو بنحو " },
                        { "type": "price", "text": "₱19" },
                        { "text": ". وفي الميناء تعبر بقارب صغير إلى سفينة الركاب وتدفع " },
                        { "type": "price", "text": "₱10" },
                        { "text": " للشخص." }
                      ]
                    },
                    {
                      "children": [
                        {
                          "text": "وإذا كانت معك مجموعة فمن المؤكد أكثر استئجار قارب بانكا كامل. وهو نحو "
                        },
                        { "type": "price", "text": "₱3,000–6,000" },
                        { "text": " للذهاب والعودة، ويُتفاوض عليه بحسب العدد ووقت الانتظار." }
                      ]
                    },
                    {
                      "children": [
                        {
                          "text": "وتنطلق قوارب البانكا المستأجرة عادة من ساحلي إيليهان ودلا باز في مدينة باتانغاس القريبين من الجزيرة، ويستغرق الوصول إلى الجزيرة نحو "
                        },
                        { "type": "duration", "text": "45 دقيقة–ساعة" },
                        { "text": ". ويبدأ القارب الواحد لستة أشخاص من نحو " },
                        { "type": "price", "text": "₱3,500" },
                        { "text": "." }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "title": "القارب — منتجعات الغوص",
              "icon": "directions_boat",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    {
                      "children": [
