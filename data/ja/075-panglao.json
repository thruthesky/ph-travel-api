                    }
                  ]
                }
              ]
            },
            {
              "title": "4日目",
              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    { "time": "午前", "children": [{ "text": "体験ダイビングまたはナパリングポイントでシュノーケリング" }] },
                    { "time": "午後", "children": [{ "text": "ボホール・ビー・ファームなどのカフェで休憩後、空港へ移動" }] }
                  ]
                }
              ]
            }
          ]
