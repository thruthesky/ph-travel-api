                        { "text": ")" }
                      ]
                    },
                    { "time": "午後4時", "children": [{ "text": "アロナビーチ散策と水泳" }] },
                    { "time": "夕方", "children": [{ "text": "ビーチのレストランで海鮮の夕食、翌日のホッピングツアーを予約" }] }
                  ]
                }
              ]
            },
            {
