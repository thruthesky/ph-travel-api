                    { "time": "午前7時30分〜10時", "children": [{ "text": "バリカサグ島シュノーケリング" }] },
                    { "time": "午前10時30分", "children": [{ "text": "バージンアイランドの砂州訪問" }] },
                    { "time": "正午", "children": [{ "text": "宿へ帰還後、昼食と休憩" }] },
                    { "time": "午後3時", "children": [{ "text": "ヒナグダナン洞窟とダウイス教会" }] },
                    { "time": "夕方", "children": [{ "text": "アロナビーチのサンセット鑑賞" }] }
                  ]
