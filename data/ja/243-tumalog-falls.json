                { "text": "セブ・シティへ戻る途中のシボンガにあり、車で約" },
                { "type": "duration", "text": "2時間" },
                { "text": "です。城のような教会と奇跡の聖母への信仰で巡礼者が集まる場所です。" }
              ]
            },
            {
              "type": "card",
              "title": "ドゥマゲテ",
              "place": "dumaguete",
              "children": [
                { "text": "リロアン港からフェリーで約" },
                { "type": "duration", "text": "20〜30分" },
                { "text": "で渡れるネグロス島の大学都市で、アポ島やシキホール島への出発地です。" }
              ]
            }
          ]
        }
      ]
