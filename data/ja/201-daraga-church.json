                { "text": "車で約" },
                { "type": "duration", "text": "1時間30分" },
                { "text": "、ジンベエザメと泳ぎ、ホタルが舞う川のクルーズを楽しめる場所です。" }
              ]
            }
          ]
        }
      ]
    }
