            { "label": "ファンダイビング", "price": "約₱1,600〜2,500", "note": "1回、ダイブセンター利用時、器材が含まれるか要確認" },
            { "label": "サブラヤン宿泊", "price": "約₱1,000〜3,500", "note": "1泊" },
