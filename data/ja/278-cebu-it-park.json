                        { "type": "duration", "text": "4時間30分" },
                        { "text": "です。" }
                      ]
                    },
                    {
                      "children": [
                        { "text": "空港はマクタン島にあり、ITパークまでは橋を渡って約" },
                        { "type": "distance", "text": "15km" },
                        { "text": "です。空港ターミナルの区分や航空会社については" },
                        { "type": "place_link", "text": "セブシティ", "slug": "cebu-city" },
                        { "text": "の項目に詳しくあります。" }
