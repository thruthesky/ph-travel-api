            { "label": "トライシクルチャーター", "price": "片道約₱200〜350", "note": "往復・待ち時間交渉" },
            { "label": "公園入場料", "price": "約₱20〜100", "note": "管理事務所で支払い、変動あり" },
            { "label": "ガイド代", "price": "グループごとに約₱300〜800", "note": "洞窟探訪時に推奨" },
            { "label": "マナルモン山登録・ガイド", "price": "約₱300〜700", "note": "登山口で支払い" },
            { "label": "ヘッドランプレンタル", "price": "約₱50〜100", "note": "可能な場合" },
            { "label": "食事", "price": "1食約₱100〜300", "note": "弁当持参推奨" },
            { "label": "ミルク菓子のお土産", "price": "約₱100〜500", "note": "パスティリャス・イエマ" }
          ]
        },
