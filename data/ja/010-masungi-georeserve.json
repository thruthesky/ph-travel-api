                      "children": [{ "text": "アンティポロ大聖堂を訪問、スマン(もち米菓子)・カシューナッツのお土産ショッピング" }]
                    },
                    { "time": "16:30", "children": [{ "text": "アンティポロの丘の展望カフェでマニラ市街を眺める" }] },
                    { "time": "18:00", "children": [{ "text": "メトロマニラの夜景を見ながら帰還" }] }
                  ]
