                      ]
                    },
                    {
                      "time": "夜",
                      "children": [{ "text": "マニラへ帰還 — 曲がりくねった山道なので、運転手付きの貸切車両が楽です" }]
                    }
                  ]
                }
              ]
            }
          ]
        }
