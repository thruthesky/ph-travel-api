                    { "time": "08:30", "children": [{ "text": "サポットのクモの巣展望台" }] },
                    { "time": "09:30", "children": [{ "text": "ドゥヤン・ハンモックとパタック休憩所" }] },
                    { "time": "10:30", "children": [{ "text": "タタイ頂上展望台" }] },
                    { "time": "11:30", "children": [{ "text": "トレイル終了、入口の休憩所で休む" }] },
                    { "time": "12:30", "children": [{ "text": "マルコス・ハイウェイの休憩食堂で昼食" }] },
                    { "time": "14:00", "children": [{ "text": "マニラへ帰還" }] }
                  ]
