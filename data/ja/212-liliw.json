                { "text": "。滝の下の食堂で足を水に浸して食事をする、ココナッツ農園のリゾートです。" }
              ]
            },
            {
              "type": "card",
              "title": "ルクバン",
              "place": "lucban",
              "children": [
                { "text": "車で約" },
                { "type": "duration", "text": "1時間30分" },
                { "text": "。ケソン州の古い町で、パンシット・ハバハバと5月のパヒヤス祭りで有名です。" }
              ]
            },
            {
              "type": "card",
              "title": "キランギン滝",
              "children": [
                { "text": "トライシクルで登山口まで行ったあと、徒歩で約" },
                { "type": "duration", "text": "45分〜1時間" },
                { "text": "。バナハウ山の湧き水が集まった2段の滝です。" }
              ]
            }
          ]
        }
      ]
    }
  ]
