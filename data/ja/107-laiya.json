            { "label": "環境税", "price": "1人約₱50", "note": "最新情報を確認" },
            { "label": "リゾートデイツアー入場料", "price": "1人約₱300〜3,000", "note": "コテージリゾート〜高級リゾート" },
            { "label": "コテージレンタル", "price": "約₱800〜3,000", "note": "大きさ・リゾートにより異なる" },
            { "label": "ビーチホッピングボート", "price": "船1隻約₱2,500〜3,500", "note": "約8〜10人" },
            { "label": "宿泊", "price": "1泊約₱2,500〜12,000", "note": "週末・繁忙期は上昇" },
            { "label": "食事", "price": "1食約₱250〜600", "note": "リゾート食堂基準" }
          ]
        },
        {
          "type": "caption",
          "children": [
            { "text": "料金は" },
            { "type": "date", "text": "2026年" },
