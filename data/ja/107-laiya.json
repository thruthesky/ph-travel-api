              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    { "time": "06:00", "children": [{ "text": "マニラ出発、SLEX〜STARトールウェイ経由" }] },
                    { "time": "10:00", "children": [{ "text": "ライヤ到着、荷物を預けてビーチ散策" }] },
                    { "time": "12:00", "children": [{ "text": "リゾートで昼食後チェックイン" }] },
                    { "time": "14:00〜17:00", "children": [{ "text": "水泳、カヤック、ビーチホッピングボート" }] },
                    { "time": "18:30", "children": [{ "text": "ビーチバーベキューの夕食と焚き火" }] }
                  ]
                }
              ]
            },
            {
