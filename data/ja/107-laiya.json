                    { "time": "13:30〜15:00", "children": [{ "text": "ビーチホッピングボートまたは日陰で休憩" }] },
                    { "time": "15:30", "children": [{ "text": "シャワー後に出発、夕方の渋滞前にマニラ方面へ移動" }] }
                  ]
                }
