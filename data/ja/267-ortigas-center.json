                        { "text": "MRTかタクシーでショー大通り方面へ南下し、SMメガモールのメガ・ファッション・ホールとシャングリ・ラ・プラザを見て回ります" }
                      ]
                    },
                    {
                      "time": "19:00",
                      "children": [{ "text": "ザ・ポディウムかシャングリ・ラ・プラザのレストランで夕食をとります" }]
                    },
                    {
                      "time": "20:30",
                      "children": [{ "text": "マルコ・ポーロ・オルティガスのVU'sスカイバーに上がって夜景を楽しみます(月〜土)" }]
                    },
                    { "time": "22:00", "children": [{ "text": "Grabかタクシーを呼んでホテルに戻ります" }] }
                  ]
                }
              ]
            },
            {
              "title": "1日コース",
              "subtitle": "午前9時〜午後10時",
              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    { "time": "09:00", "children": [{ "text": "まずEDSA聖堂を訪れ、人の少ない時間に静かに見て回ります" }] },
                    { "time": "10:30", "children": [{ "text": "ロビンソンズ・ギャレリアを見て回り、早めの昼食をとります" }] },
                    {
                      "time": "13:00",
                      "children": [{ "text": "タクシーでADBアベニューのザ・ポディウムに移動し、カフェで休みます" }]
                    },
                    {
                      "time": "14:30",
                      "children": [{ "text": "オルティガス公園で壁画を見て、キャピトル・コモンズのエスタンシアまで歩きます" }]
                    },
                    {
                      "time": "16:00",
                      "children": [{ "text": "SMメガモールのメガ・ファッション・ホールで買い物と見物をし、アイスリンクをのぞきます" }]
                    },
                    {
                      "time": "18:30",
                      "children": [{ "text": "シャングリ・ラ・プラザ周辺で夕食をとり、夕暮れに高層ビルの明かりがともるのを眺めます" }]
                    },
                    { "time": "20:30", "children": [{ "text": "VU'sスカイバーで夜景を眺め、Grabで帰ります" }] }
                  ]
                },
                {
                  "type": "paragraph",
                  "children": [
                    { "text": "時間が余れば、タクシーで" },
                    { "type": "duration", "text": "10〜20分" },
                    { "text": "の距離にあるグリーンヒルズ・ショッピングセンターやカピトリヨのレストラン街を組み合わせられます。マニラ首都圏のほかの都心は、" },
                    { "type": "place_link", "text": "BGC", "slug": "bgc" },
                    { "text": "と" },
                    { "type": "place_link", "text": "マカティ", "slug": "makati" },
                    { "text": "の項目でご覧いただけます。" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "key": "getting_there",
