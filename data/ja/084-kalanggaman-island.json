            },
            { "label": "入場料(1泊)", "price": "外国人約₱1,500、フィリピン人約₱225〜450", "note": "キャンプ込み" },
            { "label": "バンカーボート往復貸切", "price": "1隻約₱4,500〜6,000", "note": "20〜35人乗りの目安、人数で分担" },
            { "label": "コテージレンタル", "price": "1棟約₱375〜1,000", "note": "大きさにより異なる" },
            { "label": "テントレンタル", "price": "約₱300〜600", "note": "運営の有無を事前確認" },
            { "label": "タクロバン〜パロンポンバン", "price": "片道約₱300〜400", "note": "オルモック乗り換え込み" },
            {
              "label": "セブ〜オルモック高速船",
              "price": "片道約₱1,100〜1,600",
              "note": "座席の等級別、燃油サーチャージは別途の場合あり"
            },
            { "label": "食事の材料", "price": "1人約₱300〜600", "note": "パロンポン市場で購入" },
            { "label": "シュノーケル器材レンタル", "price": "1セット約₱100〜150", "note": "パロンポンで事前に借りる" }
          ]
        },
        {
          "type": "caption",
          "children": [
            { "text": "料金は" },
            { "type": "date", "text": "2026年" },
            { "text": "時点の目安で、現地の状況により変わる場合があります。" }
