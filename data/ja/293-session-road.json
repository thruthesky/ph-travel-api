              "place": "mines-view-park",
              "children": [
                { "text": "約" },
                { "type": "distance", "text": "4km" },
                { "text": "、ジプニーで約" },
                { "type": "duration", "text": "15〜20分" },
                { "text": "。旧鉱山の渓谷を望む展望台と、グッド・シェパード修道院のみやげ物店があります。" }
              ]
            },
            {
              "type": "card",
              "title": "ラ・トリニダードのイチゴ農園",
              "place": "la-trinidad-strawberry-farm",
              "children": [
                { "text": "北へ約" },
                { "type": "distance", "text": "6km" },
                { "text": "、ジプニーで約" },
                { "type": "duration", "text": "20〜40分" },
                { "text": "。イチゴ狩りをしたり、野菜市場を見て回ったりできます。" }
              ]
            }
          ]
        }
      ]
    }
  ]
