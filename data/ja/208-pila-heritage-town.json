          "blocks": [
            {
              "type": "card",
              "place": "pagsanjan-falls",
              "title": "パグサンハン滝",
              "children": [
                { "text": "車で約" },
                { "type": "duration", "text": "30〜40分" },
                { "text": "。バンカーに乗って峡谷の急流をさかのぼる、ラグナを代表する名所です。" }
              ]
            },
            {
              "type": "card",
              "place": "nagcarlan-underground-cemetery",
              "title": "ナグカルラン地下墓地",
              "children": [
                { "text": "車で約" },
                { "type": "duration", "text": "50分〜1時間" },
                { "text": "。スペイン時代の地下納骨堂が残る山すその町の国家歴史記念物です。" }
              ]
            },
            {
              "type": "card",
              "place": "mount-makiling",
              "title": "ロス・バニョスとマキリン山",
              "children": [
                { "text": "車で約" },
                { "type": "duration", "text": "45分〜1時間" },
                { "text": "。ピラへ向かう途中にある温泉の町で、マキリン山の森の道とブコパイで有名です。" }
              ]
            },
            {
              "type": "card",
              "place": "lake-pandin",
              "title": "パンディン湖",
              "children": [
                { "text": "車で約" },
                { "type": "duration", "text": "1時間30分" },
                { "text": "。サンパブロの七つの湖の一つで、竹の筏で渡る静かな湖です。" }
              ]
            },
            {
              "type": "card",
              "place": "rizal-shrine-calamba",
              "title": "カランバのリサール生家",
              "children": [
                { "text": "車で約" },
                { "type": "duration", "text": "1時間〜1時間30分" },
                { "text": "。国民的英雄ホセ・リサールが生まれた家で、マニラに戻る途中に立ち寄るのに向いています。" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
