          "columns": ["項目", "費用の目安", "備考"],
          "items": [
            { "label": "マニラ〜タルラック・シティ バス", "price": "片道約₱250〜350", "note": "エアコンバス基準" },
            { "label": "タルラック・シティ〜ルビガン ジプニー", "price": "片道約₱40〜60", "note": "サンホセ方面" },
