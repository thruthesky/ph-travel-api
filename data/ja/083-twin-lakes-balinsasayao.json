                { "text": "。峡谷の中の階段道の先に落ちる細い滝で、1日コースにまとめるのに向いています。" }
              ]
            },
            {
              "type": "card",
              "title": "ダウイン",
              "place": "dauin",
              "children": [
                { "text": "ドゥマゲテから南へ車で約" },
                { "type": "duration", "text": "30分" },
                { "text": "。黒砂のビーチとマックダイビングで知られる海岸の町です。" }
              ]
            },
            {
              "type": "card",
              "title": "アポ島",
              "place": "apo-island",
              "children": [
                { "text": "マラタパイ桟橋まで車で約" },
                { "type": "duration", "text": "40~60分" },
                { "text": "、船で約" },
                { "type": "duration", "text": "30~45分" },
                { "text": "。ウミガメとのシュノーケリングの名所です。" }
              ]
            },
            {
              "type": "card",
              "title": "シキホール島",
              "place": "siquijor",
              "children": [
                { "text": "ドゥマゲテから高速船で約" },
                { "type": "duration", "text": "45分~1時間" },
                { "text": "。滝と静かなビーチがある島です。" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
