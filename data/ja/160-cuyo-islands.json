          "columns": ["項目", "費用の目安", "備考"],
          "items": [
            { "label": "マニラ〜イロイロ 航空", "price": "約₱1,500〜4,500", "note": "片道" },
            { "label": "イロイロ〜クーヨー ロロ船", "price": "約₱1,600〜2,100", "note": "片道、一般席〜エアコン席" },
            { "label": "クーヨー〜プエルト・プリンセサ ロロ船", "price": "約₱1,800〜2,500", "note": "片道、約15時間" },
            { "label": "トライシクル", "price": "約₱20〜50", "note": "タウン内1回" },
            { "label": "バイクレンタル", "price": "約₱500〜700", "note": "1日" },
            { "label": "アイランドホッピング バンカ船チャーター", "price": "約₱2,500〜4,000", "note": "1隻、1日" },
            { "label": "宿泊", "price": "約₱800〜2,500", "note": "1泊、ペンション〜小型リゾート" },
