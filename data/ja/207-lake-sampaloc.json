              "place": "villa-escudero",
              "children": [
                { "text": "車で約" },
                { "type": "duration", "text": "30〜40分" },
                { "text": "。滝の下で食事をするココナッツ農園のリゾートです。" }
              ]
            },
            {
              "type": "card",
              "title": "ナグカルラン地下墓地",
              "place": "nagcarlan-underground-cemetery",
