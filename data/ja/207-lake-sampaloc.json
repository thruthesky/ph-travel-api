                { "type": "duration", "text": "30〜40分" },
                { "text": "。スペイン植民地時代に造られた、フィリピン唯一の地下墓地です。" }
              ]
            },
            {
              "type": "card",
              "title": "マキリン山とロス・バニョス",
              "place": "mount-makiling",
              "children": [
                { "text": "車で約" },
                { "type": "duration", "text": "1時間" },
                { "text": "。温泉リゾートと森の散策路、ブコパイで有名です。" }
              ]
            },
            {
              "type": "card",
              "title": "ルクバン",
              "place": "lucban",
              "children": [
                { "text": "車で約" },
                { "type": "duration", "text": "1時間〜1時間30分" },
                { "text": "。パヒヤス祭りとロンガニサで有名な、ケソン州の山のふもとの町です。" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
