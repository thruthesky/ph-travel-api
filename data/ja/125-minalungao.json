                    { "time": "09:30", "children": [{ "text": "登録と入場料支払い、川辺の小屋とライフジャケットのレンタル" }] },
                    { "time": "10:00〜11:30", "children": [{ "text": "竹の筏で峡谷上流の断崖と岩のアーチを見物" }] },
