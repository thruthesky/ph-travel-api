          "columns": ["項目", "費用の目安", "備考"],
          "items": [
            { "label": "マニラ〜ガパン バス", "price": "片道約₱280〜330", "note": "クバオ発" },
            { "label": "ガパン〜ヘネラル・ティニオ ジプニー", "price": "片道約₱30〜50", "note": "ガパン市街地発" },
            { "label": "トライシクルチャーター", "price": "片道約₱200〜400", "note": "往復・待ち時間交渉" },
