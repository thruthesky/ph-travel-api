                    { "time": "14:00", "children": [{ "text": "チェックイン後、昼寝かビーチ散策" }] },
                    { "time": "16:30", "children": [{ "text": "2回目のレッスン、またはボードだけ借りて自主練習" }] },
                    { "time": "18:00", "children": [{ "text": "ビーチで夕焼け鑑賞" }] },
                    { "time": "19:30", "children": [{ "text": "ビーチの食堂で夕食、ライブ音楽バーを見物" }] }
                  ]
                }
              ]
            },
            {
              "title": "2日目",
              "subtitle": "サン・フェルナンドと滝",
              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    { "time": "06:30", "children": [{ "text": "早朝サーフィンかビーチヨガ" }] },
                    { "time": "09:00", "children": [{ "text": "サン・ガブリエルへ移動してタンガダン滝でトレッキングと遊泳" }] },
                    { "time": "13:00", "children": [{ "text": "サン・フェルナンドへ戻って昼食、ハロハロ・デ・イロコ" }] },
                    { "time": "14:30", "children": [{ "text": "マチョ寺院、ピンダンガン教会跡を見学" }] },
