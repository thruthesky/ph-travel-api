                    {
                      "time": "10:00",
                      "children": [{ "text": "チェックアウト、お土産にイロコス酢とトウモロコシ菓子チチャコンを購入" }]
                    },
                    { "time": "12:00", "children": [{ "text": "昼食後マニラ行きバスに乗車、またはビガン・バギオ方面へ移動" }] }
                  ]
                }
              ]
            }
          ]
