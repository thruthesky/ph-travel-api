                { "type": "distance", "text": "7km" },
                { "text": "、車で" },
                { "type": "duration", "text": "20〜30分" },
                { "text": "。チキン・イナサルと州庁舎のラグーン公園、マスカラ祭りの街" }
              ]
            },
            {
              "type": "card",
              "title": "シライ",
              "place": "silay",
              "children": [
                { "text": "北へ約" },
                { "type": "distance", "text": "14km" },
                { "text": "、車で" },
                { "type": "duration", "text": "20〜30分" },
                { "text": "。砂糖成金たちの木造邸宅が残るヘリテージ通り" }
              ]
            },
            {
              "type": "card",
              "title": "マンブカル・リゾート",
              "place": "mambukal",
              "children": [
                { "text": "南東へ車で約" },
                { "type": "duration", "text": "1時間" },
                { "text": "。カンラオン火山の麓の硫黄温泉と七つの滝" }
              ]
            },
            {
              "type": "card",
              "title": "ラカウォン島",
              "place": "lakawon-island",
              "children": [
                { "text": "北のカディスまで車で約" },
                { "type": "duration", "text": "1時間30分〜2時間" },
                { "text": "、船で" },
                { "type": "duration", "text": "15〜20分" },
                { "text": "。白い砂と水上バーの島" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
