          "items": [
            { "label": "マニラ〜サン・フェリペ間のバス", "price": "片道約₱500〜600", "note": "ビクトリー・ライナー急行基準" },
            { "label": "トライシクル", "price": "1人約₱40〜50", "note": "市場〜ビーチ間の乗り合い" },
            { "label": "環境税・海岸保全費", "price": "1人約₱50", "note": "学生・シニア割引あり、最新の告知を確認" },
            { "label": "サーフィンレッスン", "price": "1時間約₱600〜700", "note": "ボードレンタル込み" },
