            { "label": "チャーターボート", "price": "約₱4,000〜8,000", "note": "1隻、片道" },
            { "label": "アイランドホッピング バンカ船チャーター", "price": "約₱3,000〜5,000", "note": "1隻、1日" },
            { "label": "ビーチ・キャンプ利用料", "price": "約₱100〜300", "note": "1人、島ごとに異なる" },
            { "label": "宿泊", "price": "約₱1,000〜3,000", "note": "1泊、ロッジ・島のキャンプ" },
            { "label": "食事", "price": "約₱500〜1,000", "note": "1人1日" }
          ]
        },
        {
          "type": "caption",
          "children": [
            { "text": "料金は" },
            { "type": "date", "text": "2026年" },
