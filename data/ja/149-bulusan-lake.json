            { "label": "公園入場料・環境税", "price": "約₱50+₱10", "note": "学生約₱25" },
            { "label": "シャトル・電動ジプニー", "price": "往復約₱35", "note": "徒歩も可能" },
            { "label": "カヤック・パドルボード", "price": "30分約₱100/₱200", "note": "ガイド約₱100別途" },
            { "label": "手漕ぎボート", "price": "約₱600", "note": "最大5人、漕ぎ手込み" },
            { "label": "エコガイド", "price": "1時間あたり約₱150", "note": "任意" },
            { "label": "宿泊", "price": "1泊約₱1,000〜3,500", "note": "町の旅館〜リゾート" }
          ]
        },
        {
          "type": "caption",
          "children": [
            { "text": "料金は" },
