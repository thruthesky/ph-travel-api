                { "type": "duration", "text": "1時間" },
                { "text": "上った山の中にある、双子の火山湖と熱帯雨林です。" }
              ]
            },
            {
              "type": "card",
              "title": "カサロロ滝",
              "place": "casaroro-falls",
              "children": [
                { "text": "車で約" },
                { "type": "duration", "text": "30〜40分" },
                { "text": "。約335段の階段を下りた先にある、高さ約" },
                { "type": "distance", "text": "30m" },
                { "text": "の渓谷の滝です。" }
              ]
            }
          ]
        }
      ]
