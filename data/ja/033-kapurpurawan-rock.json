                    { "time": "14:00", "children": [{ "text": "パグドゥプッドを出発、バンギ風車群を経由" }] },
                    { "time": "15:30", "children": [{ "text": "ボヘアドール岬灯台" }] },
                    { "time": "16:30", "children": [{ "text": "カプルプラワン岩で夕暮れの撮影" }] },
                    {
                      "time": "18:00",
                      "children": [
                        { "text": "ラオアグへ帰還(約" },
                        { "type": "duration", "text": "1時間30分" },
