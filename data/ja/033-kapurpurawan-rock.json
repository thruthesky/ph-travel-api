                        { "text": ")" }
                      ]
                    },
                    { "time": "09:00", "children": [{ "text": "カプルプラワン岩に到着、遊歩道を歩くかポニーで移動" }] },
                    { "time": "09:20", "children": [{ "text": "岩周辺で写真撮影、展望の丘からの眺め" }] },
                    {
                      "time": "10:30",
                      "children": [
                        { "text": "ボヘアドール岬灯台を見学(車で約" },
                        { "type": "duration", "text": "10分" },
                        { "text": ")" }
                      ]
                    },
                    { "time": "11:30", "children": [{ "text": "ブルゴス風力発電団地を道路脇から眺める" }] },
                    { "time": "12:00", "children": [{ "text": "バンギ風車群に到着、ビーチ散策と昼食" }] },
                    { "time": "13:30", "children": [{ "text": "パグドゥプッドへ移動してビーチで休憩、またはラオアグへ帰還" }] }
                  ]
                }
              ]
            },
            {
              "title": "写真旅行者向け午後遅めコース",
              "blocks": [
                {
                  "type": "stepper",
