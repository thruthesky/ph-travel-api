                      ]
                    },
                    {
                      "children": [
                        { "text": "イロイロなどの旅行会社が交通・宿泊・ホッピング・食事をまとめた" },
                        { "type": "duration", "text": "1泊2日〜2泊3日" },
                        { "text": "パッケージを運営しており、個別旅行より便利です。" }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
