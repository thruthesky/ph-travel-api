                    },
                    { "time": "2日目05:30〜07:00", "children": [{ "text": "山頂で日の出と雲海を鑑賞" }] },
                    { "time": "2日目07:00〜10:00", "children": [{ "text": "下山、レンジャーステーションで朝食" }] },
                    {
