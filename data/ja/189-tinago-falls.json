                    { "time": "08:00", "children": [{ "text": "イリガン到着後、半日チャーター車でティナゴ滝へ移動" }] },
                    { "time": "08:30〜11:30", "children": [{ "text": "ティナゴ滝の階段を下山、筏と水泳" }] },
                    { "time": "12:30", "children": [{ "text": "道端の食堂で昼食後、ミンバルット滝を見学" }] },
                    { "time": "14:30", "children": [{ "text": "ティモガ冷泉プールで休憩" }] },
