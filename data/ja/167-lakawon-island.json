                    },
                    { "time": "15:00", "children": [{ "text": "島一周散策と写真撮影" }] },
                    { "time": "16:00", "children": [{ "text": "ボートで港へ戻る、カディスからバコロド行きのバスに乗車" }] }
                  ]
                },
