                { "text": "車で約" },
                { "type": "duration", "text": "2時間" },
                { "text": "、ボホール東端の静かな白砂浜と洞窟プールがあります。" }
              ]
            },
            {
              "type": "card",
              "title": "ビラール人工マホガニー林",
              "place": "bilar-man-made-forest",
              "children": [
                { "text": "チョコレート・ヒルズから車で約" },
                { "type": "duration", "text": "40分" },
                { "text": "、ロアイ内陸道路の両側にマホガニーの木がトンネルのように続きます。" }
              ]
            }
          ]
        }
      ]
    }
  ]
