                    { "time": "午前11時30分〜午後1時", "children": [{ "text": "ロボック川の昼食ビュッフェクルーズ" }] },
                    { "time": "午後1時30分", "children": [{ "text": "ビラールのマホガニー林を通過" }] },
                    { "time": "午後2時〜3時30分", "children": [{ "text": "チョコレート・ヒルズ展望台とATV体験" }] },
