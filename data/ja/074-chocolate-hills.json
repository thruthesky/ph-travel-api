                    { "time": "午前9時〜11時", "children": [{ "text": "展望台見学とATVまたはアドベンチャーパーク" }] },
                    { "time": "午前11時30分", "children": [{ "text": "展望台敷地のカフェかカルメン町内の食堂で昼食" }] },
                    { "time": "午後1時", "children": [{ "text": "トゥビゴン港へ出発" }] },
                    {
