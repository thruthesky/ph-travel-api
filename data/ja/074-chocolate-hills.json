                { "type": "duration", "text": "1時間" },
                { "text": "、手のひらほどの大きさのターシャを間近で見られます。" }
              ]
            },
            {
              "type": "card",
              "title": "パングラオ島",
              "place": "panglao",
              "children": [
                { "text": "車で約" },
                { "type": "duration", "text": "1時間30分〜2時間" },
                { "text": "、アロナビーチとホッピングツアーで名高いボホールの代表的なリゾート地です。" }
              ]
            },
            {
              "type": "card",
