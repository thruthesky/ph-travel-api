                { "type": "duration", "text": "2〜2時間30分" },
                { "text": "、野生のジンベエザメとサンゴの壁ダイビングで有名な南レイテの湾です。" }
              ]
            },
            {
              "type": "card",
              "title": "ダナオ湖(オルモック)",
              "place": "lake-danao",
              "children": [
                { "text": "車で約" },
                { "type": "duration", "text": "2時間30分〜3時間" },
                { "text": "、山中にあるギターの形をした湖で、涼しい空気を楽しめます。" }
              ]
            },
            {
              "type": "card",
              "title": "カランガマン島",
              "place": "kalanggaman-island",
              "children": [
                { "text": "車でパロンポンまで約" },
                { "type": "duration", "text": "3〜3時間30分" },
                { "text": "、船で約" },
                { "type": "duration", "text": "1時間" },
                { "text": "。鳥の翼のような形の砂州が広がる島です。" }
              ]
            },
            {
              "type": "card",
              "title": "カモテス諸島",
              "place": "camotes-islands",
              "children": [
                { "text": "オルモックから船で約" },
                { "type": "duration", "text": "2〜3時間" },
                { "text": "、湖と洞窟、白砂浜が調和するセブ側の島々です。" }
              ]
            }
          ]
        }
      ]
    }
  ]
