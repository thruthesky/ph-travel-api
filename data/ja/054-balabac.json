                        { "type": "duration", "text": "2〜4時間" },
                        { "text": ")、最初の島に到着後海水浴" }
                      ]
                    },
                    { "time": "夕方", "children": [{ "text": "カンダラマンなど宿泊する島でシーフードの夕食と星空観賞" }] }
                  ]
                }
              ]
            },
