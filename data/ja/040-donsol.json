                        { "text": ")" }
                      ]
                    },
                    { "time": "11:30", "children": [{ "text": "ビジターセンターへ帰還、宿にチェックインして昼食" }] },
                    { "time": "13:30", "children": [{ "text": "ビーチリゾートで休憩" }] },
