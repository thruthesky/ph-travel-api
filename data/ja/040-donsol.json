                    },
                    {
                      "children": [
                        { "text": "または" },
                        { "type": "time", "text": "07:00" },
                        { "text": "からマンタ・ボウルダイビング(ダイバー対象、半日)" }
                      ]
                    },
                    { "time": "11:30", "children": [{ "text": "昼食後にチェックアウト" }] },
                    { "time": "13:00", "children": [{ "text": "レガスピへ移動、カグサワ遺跡とマヨン火山観光へつなげる" }] }
                  ]
                }
              ]
            }
          ]
