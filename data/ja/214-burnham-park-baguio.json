                { "text": "、松の尾根を歩く半日トレッキングの名所です。" }
              ]
            },
            {
              "type": "card",
              "title": "マインズビュー・パーク",
              "children": [
                { "text": "タクシーで約" },
                { "type": "duration", "text": "15〜25分" },
                { "text": "、旧鉱山地帯を見下ろす展望台とみやげ物店があります。" }
              ]
            },
            {
              "type": "card",
              "title": "キャンプ・ジョン・ヘイ",
              "children": [
                { "text": "タクシーで約" },
                { "type": "duration", "text": "15〜20分" },
                { "text": "、松林の遊歩道とカフェが集まる憩いのエリアです。" }
              ]
            }
          ]
        }
      ]
    }
