            { "label": "リゾート入場料", "price": "約₱50〜200", "note": "日帰り訪問時" },
            { "label": "テントサイト", "price": "1泊約₱200〜300", "note": "テントレンタルは約₱300〜600追加" },
            { "label": "扇風機付き小屋", "price": "1泊約₱1,000〜2,000", "note": "2〜4人基準" },
            { "label": "エアコン付き客室", "price": "1泊約₱3,000〜5,000", "note": "電力供給時間を確認" },
            { "label": "食事", "price": "1食約₱150〜350", "note": "リゾートの食堂・パルト" }
          ]
        },
        {
          "type": "caption",
