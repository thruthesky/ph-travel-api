                { "type": "duration", "text": "15〜25分" },
                { "text": "。スペイン総督の宮殿があった城壁都市で、マラカニアン宮殿が官邸になる前の歴史を続けてたどれます。" }
              ]
            },
            {
              "type": "card",
              "title": "ビノンド・チャイナタウン",
              "place": "binondo",
              "children": [
                { "text": "約" },
                { "type": "distance", "text": "2.5km" },
