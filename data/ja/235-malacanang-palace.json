              "children": [
                { "text": "約" },
                { "type": "distance", "text": "1.3km" },
                { "text": "、グラブで約" },
                { "type": "duration", "text": "10〜15分" },
                { "text": "。黒いナザレのイエス像で有名で、教会前の市場歩きも楽しめます。" }
              ]
            },
            {
              "type": "card",
