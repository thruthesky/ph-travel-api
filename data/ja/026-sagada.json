                    },
                    { "time": "16:30", "children": [{ "text": "ダヌム湖または村の散策、日没" }] },
                    { "time": "19:00", "children": [{ "text": "夕食後は早めに就寝" }] }
                  ]
                }
              ]
            },
            {
              "title": "2日目",
              "subtitle": "日の出と洞窟",
              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    {
                      "time": "04:30",
                      "children": [{ "text": "キルテパンへの道沿いのカフェへ雲海の日の出を見に出発(チャーターバンまたは徒歩)" }]
                    },
                    { "time": "05:30", "children": [{ "text": "雲海の日の出を鑑賞" }] },
                    { "time": "08:00", "children": [{ "text": "朝食" }] },
                    {
                      "time": "09:30〜12:00",
                      "children": [
                        { "text": "ルミアン埋葬洞窟→スマギン洞窟の連結コース(またはスマギン単独" },
                        { "type": "duration", "text": "2時間" },
                        { "text": ")" }
                      ]
                    },
                    { "time": "13:00", "children": [{ "text": "昼食、宿でシャワーと休憩" }] },
                    { "time": "15:00", "children": [{ "text": "サガダ焼きの工房、織物店を見学" }] },
                    { "time": "19:00", "children": [{ "text": "暖炉のある食堂で夕食" }] }
                  ]
                }
              ]
            },
            {
              "title": "3日目",
              "subtitle": "滝トレッキングと移動",
              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    { "time": "07:00", "children": [{ "text": "フィデリサン方面へ移動、棚田沿いにボモドック滝トレッキング" }] },
                    { "time": "11:00", "children": [{ "text": "村へ戻り昼食" }] },
                    { "time": "13:00", "children": [{ "text": "ボントックまたはバギオ行きバス・バンに乗車、次の目的地へ移動" }] }
                  ]
                }
              ]
            },
            {
              "title": "マルボロ・ヒル日の出コース",
              "subtitle": "雲海とブルーソイルのトレッキング(半日)",
              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    {
                      "time": "前日の午後",
                      "children": [{ "text": "観光案内所でマルボロ・ヒル・ブルーソイルのガイドとシャトルを予約" }]
                    },
                    { "time": "03:30", "children": [{ "text": "起床、防寒着・ヘッドランプ・水を準備" }] },
                    { "time": "04:00", "children": [{ "text": "シャトルで登山口へ移動、ガイドと松林の山道を歩き始める" }] },
                    { "time": "05:30", "children": [{ "text": "マルボロ・ヒル山頂で雲海と日の出を鑑賞" }] },
                    {
                      "time": "07:00",
                      "children": [
                        { "text": "尾根沿いにブルーソイルの丘へ下るトレッキング(約" },
                        { "type": "duration", "text": "2時間" },
                        { "text": ")" }
                      ]
                    },
                    { "time": "09:00", "children": [{ "text": "ブルーソイルの丘で写真撮影後、シャトルで村へ戻る" }] },
                    { "time": "10:00", "children": [{ "text": "遅めの朝食、午後は宿で休憩またはダヌム湖を散策" }] }
                  ]
                },
                {
                  "type": "paragraph",
                  "children": [
                    {
                      "text": "マルボロ・ヒルのコースはガイド同行が義務で、シャトル代が別途かかります。夜明け前の山道は暗く、夜露で滑りやすいので、ヘッドランプと滑りにくい靴を用意してください。"
                    }
                  ]
                }
              ]
            },
            {
              "title": "雨の日コース",
              "subtitle": "洞窟・滝が閉鎖されているとき",
              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    { "time": "09:00", "children": [{ "text": "観光案内所でその日開いている名所と閉鎖のお知らせを確認" }] },
                    { "time": "10:00", "children": [{ "text": "セント・メアリー聖公会教会と宣教地区、カルバリーの丘墓地を散策" }] },
                    { "time": "11:30", "children": [{ "text": "サガダ・ウィービングで機織りを見学、お土産を購入" }] },
                    { "time": "13:00", "children": [{ "text": "レモン・パイ・ハウスで昼食とレモンパイ" }] },
                    { "time": "15:00", "children": [{ "text": "ヨーグルト・ハウスやカフェでサガダコーヒーを飲みながら休憩" }] },
                    { "time": "18:30", "children": [{ "text": "暖炉のある食堂で早めの夕食" }] }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "key": "getting_there",
      "title": "アクセス",
      "icon": "directions",
      "blocks": [
        {
          "type": "accordion",
          "items": [
            {
              "title": "バス(マニラ直行)",
              "icon": "directions_bus",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    {
                      "children": [
                        {
                          "text": "マニラのクバオからサガダまで、バナウェ・ボントックを経由するコーダ・ラインズ(Coda Lines)の直行夜行バスが毎日運行しています。所要時間は約"
                        },
                        { "type": "duration", "text": "11〜13時間" },
                        { "text": "、料金は座席クラスにより約" },
                        { "type": "price", "text": "₱1,300〜1,500" },
                        { "text": "です。座席数が限られているため、週末・連休は事前の予約が必要です。" }
                      ]
                    },
                    {
                      "children": [
                        {
                          "text": "クバオのターミナルは、モンテ・デ・ピエダッド通りとメリーランド通りの角(HMトランスポートのターミナル付近)にあります。サガダ観光局の案内では、"
                        },
                        { "type": "time", "text": "夜8〜10時" },
                        {
                          "text": "の間に1日2〜4便が出発し、トイレ付きの35席バスは45席バスより少し高くなります。オンライン予約はBookawayでできます。"
                        }
                      ]
                    },
                    {
                      "children": [
                        { "text": "帰りのコーダ・ラインズのバスはサガダ中心部の乗り場から" },
                        { "type": "time", "text": "昼12時30分〜午後4時" },
                        { "text": "の間に出発し、深夜か明け方にクバオに着きます。" }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "title": "バス(バギオ経由)",
              "icon": "directions_bus",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    {
                      "children": [
                        { "text": "マニラからバギオまでバスで約" },
                        { "type": "duration", "text": "4〜6時間" },
                        {
                          "text": "移動した後、バギオのダンワ・ターミナル付近でサガダ行きバス(GLトランス、リサルド・トランスなど)に乗ります。ハルセマ・ハイウェイ沿いに約"
                        },
                        { "type": "duration", "text": "5〜6時間" },
                        { "text": "かかり、料金は約" },
                        { "type": "price", "text": "₱300〜450" },
                        { "text": "です。" }
                      ]
                    },
                    {
                      "children": [
                        { "text": "ハルセマ・ハイウェイはバギオからボントックまで約" },
                        { "type": "distance", "text": "150km" },
                        { "text": "続く山道で、ベンゲット州アトックで標高約" },
                        { "type": "distance", "text": "2,255m" },
                        { "text": "まで上ります。" },
                        { "type": "date", "text": "2019年" },
                        {
                          "text": "にイフガオ州ティノックの道路のほうが高いと確認されるまでは、フィリピンで最も標高の高い国道でした。カーブが多いので、酔い止めを用意しておくとよいでしょう。"
                        }
                      ]
                    },
                    {
                      "children": [
                        { "text": "サガダ観光局が案内するバギオ発GLトランスの出発時刻は" },
                        { "type": "time", "text": "03:00" },
                        { "text": "、" },
                        { "type": "time", "text": "05:30" },
                        { "text": "、" },
                        { "type": "time", "text": "08:30" },
                        { "text": "、" },
                        { "type": "time", "text": "10:30" },
                        { "text": "、" },
                        { "type": "time", "text": "13:00" },
                        { "text": "、" },
                        { "type": "time", "text": "17:00" },
                        { "text": "です。予約はできず、センターモール裏のダンワ・ターミナルで直接切符を買う必要があるので、週末は早めに出かけてください。" }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "title": "バナウェ・ボントック経由",
              "icon": "route",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    {
                      "children": [
                        { "text": "バナウェからボントックまでバンやジプニーで約" },
                        { "type": "duration", "text": "2〜3時間" },
                        { "text": "、ボントックからサガダまでジプニーで約" },
                        { "type": "duration", "text": "1時間" },
                        { "text": "かかります。バナウェ・バタッドと組み合わせる日程に便利です。" }
                      ]
                    },
                    {
                      "children": [
                        { "text": "ボントック〜サガダ間のジプニーは主に午前から午後の早い時間まで運行し、料金は約" },
                        { "type": "price", "text": "₱70〜100" },
                        { "text": "です。遅く着くとボントックで車をチャーターしなければならないので、午前中に乗り継ぐのがおすすめです。" }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "title": "飛行機",
              "icon": "flight",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    {
                      "children": [
                        { "text": "最も近い国際空港はクラーク国際空港(CRK)で、バギオを経由して約" },
                        { "type": "duration", "text": "8〜10時間" },
                        { "text": "かかります。事実上バス移動が基本になります。" }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "title": "現地での移動",
              "icon": "commute",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    {
                      "children": [
                        {
                          "text": "村の中心部は歩いて回れます。ルミアン洞窟・スマギン洞窟、マルボロ・ヒル、ボモドック滝方面へは観光案内所の近くでチャーターバン(シャトル)を手配します。料金はコースごとの定額(1台約"
                        },
                        { "type": "price", "text": "₱400〜1,350" },
                        { "text": ")です。" }
                      ]
                    },
                    {
                      "children": [
                        {
                          "text": "ガイド同行の名所ではシャトルもあわせて利用するよう求められることが多いので、観光案内所でガイドを予約するときにシャトルも一緒に手配してください。"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "title": "自家用車",
              "icon": "directions_car",
              "blocks": [
                {
                  "type": "list",
                  "ordered": false,
                  "items": [
                    {
                      "children": [
                        {
                          "text": "マニラから車で行くルートは大きく3つあります。バギオを経由してハルセマ・ハイウェイを走るルート、ヌエバ・ビスカヤ州・イフガオ州(バナウェ)を経由してボントックへ上るルート、南イロコス州の海岸からセルバンテスを経由して上る西側のルートです。"
                        }
                      ]
                    },
                    {
                      "children": [
                        { "text": "サガダ観光局は、霧で視界が悪くなる山道での夜間運転を控えるよう呼びかけています。雨季(" },
                        { "type": "date", "text": "6月〜10月" },
                        {
                          "text": ")は土砂崩れに注意し、出発前に燃料を満タンにしてください。町なかの駐車スペースは非常に少ないので、宿に駐車場があるか事前に確認してください。"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "key": "best_time",
      "title": "ベストシーズンと天気",
      "icon": "wb_sunny",
      "blocks": [
        {
          "type": "paragraph",
          "children": [
            { "type": "date", "text": "11月〜4月" },
            { "text": "の乾季が最も旅行に適しています。" },
            { "type": "date", "text": "12月〜2月" },
            { "text": "は夜明けの気温が" },
            { "type": "temperature", "text": "10℃" },
            {
              "text": "を下回ることもある最も寒い時期ですが、雲海の確率が高く空気が澄んでいて、サガダらしい風景に出会えます。この時期はサガダオレンジが旬で、村のあちこちで新鮮なオレンジを味わえます。"
            },
            { "type": "date", "text": "3月〜5月" },
            { "text": "は暖かく晴れが多いものの、聖週間や夏休みには観光客が集中し、宿とガイドが不足することもあります。" }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            { "type": "date", "text": "6月〜10月" },
            {
              "text": "の雨季は雨が多く霧も濃くなります。洞窟は大雨の後に水量が増え連結コースが中止されることがあり、ハルセマ・ハイウェイで土砂崩れが起きて交通が止まることもあります。"
            },
            { "type": "date", "text": "11月1日" },
            { "text": "の万聖節前後には、村人が墓地に集まりろうそくを灯す追悼の光景を見られますが、村の行事なので静かに見学する必要があります。" }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            { "text": "村の祭りや共同体の行事も日程に影響します。毎年" },
            { "type": "date", "text": "1月下旬〜2月上旬" },
            {
              "text": "には伝統的な燻製豚肉をたたえるエタグ・フェスティバルが開かれ、民族舞踊のコンテストや、コーヒー・野菜を売る農産物市が立ちます。田植えや収穫の後、災害の後に村が休む「ウバヤ(ubaya)」の日にはボモドック滝などの名所が閉まり、"
            },
            { "type": "date", "text": "2025年12月1日" },
            {
              "text": "には年に一度の村の集会「サガンサン(sagangsang)」のため、エコー・バレー、スマギン洞窟、ボコン滝が1日閉鎖されました。年間平均降水量は約2,835mmで、その大半が"
            },
            { "type": "date", "text": "5月〜10月" },
            { "text": "に降ります。" }
          ]
        },
        {
          "type": "table",
          "label": "時期別早見表",
          "icon": "calendar_month",
          "columns": ["時期", "天気", "旅のポイント"],
          "rows": [
            ["11月〜2月", "乾季、12月〜2月は明け方10℃以下", "雲海・サガダオレンジの旬 — 11月1日の万聖節の追悼"],
            ["3月〜5月", "暖かく晴れ", "聖週間・夏休みは宿泊とガイドが不足"],
            ["6月〜8月", "雨季の始まり、午後の雨と濃い霧", "深い洞窟コース・ボモドック滝は随時閉鎖 — 観光案内所のお知らせを確認"],
            ["9月〜10月", "台風・豪雨が多い雨季後半", "ハルセマ・ハイウェイの土砂崩れに注意 — 1日余裕のある日程に"]
          ]
        }
      ]
    },
    {
      "type": "section",
      "key": "costs",
      "title": "費用の目安",
      "icon": "payments",
      "blocks": [
        {
          "type": "pricing",
          "currency": "PHP",
          "columns": ["項目", "費用の目安", "備考"],
          "items": [
            { "label": "マニラ〜サガダ直行バス", "price": "片道約₱1,300〜1,500", "note": "コーダ・ラインズ基準" },
            { "label": "登録・環境費", "price": "1人約₱100", "note": "領収書をすべての名所で提示" },
            { "label": "スマギン洞窟のガイド", "price": "1チーム約₱800", "note": "最大約4人" },
            { "label": "洞窟連結コースのガイド", "price": "1チーム約₱1,500", "note": "最大約4人" },
            {
              "label": "エコー・バレー・滝のガイド",
              "price": "1チーム約₱300〜500",
              "note": "エコー・バレー₱300・ボモドック滝₱500、最大約10人"
            },
            {
              "label": "マルボロ・ヒル・ブルーソイルのガイド",
              "price": "1チーム約₱1,600",
              "note": "日の出トレッキング4〜5時間、シャトル別途"
            },
            {
              "label": "名所別チャーターバン(シャトル)",
              "price": "1台約₱400〜1,350",
              "note": "スマギン₱400〜マルボロ・ヒル₱1,350、同行者と割り勘"
            },
            { "label": "宿泊", "price": "1泊約₱800〜3,000", "note": "ゲストハウス〜中級宿" },
            { "label": "食事", "price": "1食約₱200〜450", "note": "カフェ・食堂基準" }
          ]
        },
        {
          "type": "caption",
          "children": [
            { "text": "料金は" },
            { "type": "date", "text": "2026年" },
            { "text": "時点の目安で、現地の状況により変わる場合があります。" }
          ]
        }
      ]
    },
    {
      "type": "section",
      "key": "stay_and_food",
      "title": "宿泊とグルメ",
      "icon": "restaurant",
      "blocks": [
        {
          "type": "paragraph",
          "children": [
            { "text": "宿は観光案内所とバス停がある村の中心部にゲストハウスや小規模な宿(イン)が集まっています。1泊約" },
            { "type": "price", "text": "₱800〜1,500" },
            { "text": "の素朴な部屋から、松林の眺めがある約" },
            { "type": "price", "text": "₱2,000〜3,000" },
            { "text": "台の宿まで幅広くあります。エアコンは不要ですが夜は冷え込むため、お湯と厚めの布団があるか確認してください。繁忙期は到着前の予約が安心です。" }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            {
              "text": "サガダは小さな村の割に食文化が豊かです。老舗の名物「レモン・パイ・ハウス」のレモンパイ、ヨーグルト・ハウスの自家製ヨーグルトとグラノーラ、この地域の伝統的な燻製豚肉「エタグ(etag)」を使った料理、サガダ産アラビカコーヒーが代表的です。夕食ビュッフェで有名な食堂には予約制のところもあるので、昼のうちに席を確保しておいてください。店は"
            },
            { "type": "time", "text": "夜8〜9時" },
            { "text": "頃には閉まるところが多くなっています。" }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            { "text": "有名な店を挙げると、" },
            { "type": "date", "text": "2000年" },
            { "text": "からレモンパイを焼いて市場で売り、" },
            { "type": "date", "text": "2008年" },
            {
              "text": "に食堂を開いた「サガダ・レモン・パイ・ハウス」はレモンパイとエッグパイが看板メニューで、大通り沿いの「ヨーグルト・ハウス」はグラノーラとバナナをのせたヨーグルトと終日提供の朝食メニューで有名です。棚田を見下ろす「ガイア・カフェ(Gaia Cafe)」ではベジタリアン料理を出しています。サガダコーヒーは"
            },
            { "type": "date", "text": "1882〜1896年" },
            {
              "text": "にスペイン人が持ち込んだアラビカコーヒーの流れをくむもので、コーヒー豆はお土産にぴったりです。村で採れるサガダオレンジ(ポンカン)や真空パックのエタグも人気の贈り物です。"
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "key": "tips",
      "title": "旅のヒント",
      "icon": "lightbulb",
      "blocks": [
        {
          "type": "list",
          "ordered": false,
          "icon": "check_circle",
          "items": [
            {
              "children": [
                { "text": "到着したらまず観光案内所で登録し、環境費の領収書を受け取ってください。すべての名所の入り口でこの領収書を確認されます。" }
              ]
            },
            { "children": [{ "text": "ほとんどの名所は公認ガイドの同行が義務です。観光案内所やガイド協会の事務所で決められた料金で予約できます。" }] },
            {
              "children": [
                { "text": "洞窟探検の日には、濡れてもよい服、サンダルまたはアクアシューズ、着替えとタオルを用意してください。洞窟内では裸足で歩く区間もあります。" }
              ]
            },
            {
              "children": [
                { "text": "サガダの村にはATMが1〜2台しかなく、現金が不足することがよくあります。バギオやボントックで十分に引き出してきてください。" }
              ]
            },
            {
              "children": [
                { "text": "連休には、明け方の雲海スポットへ向かう道が車で混雑します。" },
                { "type": "time", "text": "午前4時" },
                { "text": "前後に出発するか、キルテパンへの道沿いのカフェのように近い場所なら歩いて行くのも一つの方法です。" }
              ]
            },
            { "children": [{ "text": "夜は気温が大きく下がります。軽量のダウン、長ズボン、靴下を用意してください。" }] },
            { "children": [{ "text": "写真を撮る際、住民、特に高齢者や儀式の場面は必ず許可を求めてください。" }] },
            {
              "children": [
                { "text": "観光案内所の行列を避けるには、サガダ郡が運営する" },
                {
                  "type": "link",
                  "text": "サガダ iPassオンライン登録",
                  "url": "https://umali-kayo.sagada.gov.ph"
                },
                {
                  "text": "で到着前に登録し、QRパスを受け取っておいてください。決済した予約は返金・譲渡ができず、台風・道路閉鎖のときだけ日付を変更できます。7歳以下の子どもは登録しなくても構いません。"
                }
              ]
            },
            {
              "children": [
                {
                  "text": "ガイド1人が担当できる人数は決まっています(スマギン洞窟は約4人、エコー・バレー・ボモドック滝は約10人)。1人や2人なら、観光案内所でほかの旅行者とチームを組んでガイド料とシャトル代を分け合うと、ずっと安くなります。"
                }
              ]
            },
            {
              "children": [
                { "text": "宿・ガイド・ツアー業者は" },
                { "type": "link", "text": "サガダ観光局公式サイト", "url": "https://tourism.sagada.gov.ph" },
                { "text": "の公認業者リストで確認でき、名所の一時閉鎖などのお知らせは観光局のFacebookページ(Sagadatourism)でも確認できます。" }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "key": "cautions",
      "title": "注意事項",
      "icon": "warning",
      "blocks": [
        {
          "type": "alert",
          "variant": "warning",
          "icon": "warning",
          "children": [
            { "text": "吊るされた棺と埋葬洞窟は、観光名所である前に住民の祖先の墓です。棺に触れたり骨を動かしたりする行為、墓の上に登って写真を撮る行為は絶対に禁止です。" }
          ]
        },
        {
          "type": "list",
          "ordered": false,
