                    { "time": "午後", "children": [{ "text": "サカホン・ビーチからボテ灯台へトレッキング" }] },
                    { "time": "夕方", "children": [{ "text": "ビラックの宿へ戻る" }] }
                  ]
                }
              ]
            },
            {
              "title": "4日目",
              "subtitle": "サン・アンドレスと離島",
              "blocks": [
                {
                  "type": "stepper",
