            { "label": "サーフィンレッスン", "price": "約₱500", "note": "1時間、ボード込み" },
            { "label": "バイクレンタル", "price": "約₱500〜700", "note": "1日、ガソリン代別" },
            { "label": "バン貸し切り", "price": "約₱3,000〜4,500", "note": "1日、運転手込み" },
            { "label": "宿泊", "price": "約₱800〜3,500", "note": "1泊、サーファー向けゲストハウス〜ビラックのホテル" },
            { "label": "食事", "price": "約₱400〜900", "note": "1人1日" }
          ]
        },
        {
