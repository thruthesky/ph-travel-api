                    { "time": "午前", "children": [{ "text": "バラカイ・ポイントの展望の丘" }] },
                    { "time": "午後", "children": [{ "text": "プララン・ビーチへ移動、サーフィンレッスンかシュノーケリング" }] },
                    { "time": "夕方", "children": [{ "text": "プララン・ビーチの宿で1泊" }] }
                  ]
                }
              ]
            },
            {
              "title": "3日目",
              "subtitle": "バトと西部",
              "blocks": [
                {
                  "type": "stepper",
