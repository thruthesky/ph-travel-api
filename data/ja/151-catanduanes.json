                      "time": "午前",
                      "children": [{ "text": "ビラック空港到着、またはタバコから船で入島、宿にチェックインしバイクをレンタル" }]
                    },
                    { "time": "午後", "children": [{ "text": "マリビナ滝で泳いだ後、ツイン・ロック・ビーチへ移動" }] },
                    { "time": "夕方", "children": [{ "text": "ビラック市街でシーフードとパンシット・バトの夕食" }] }
                  ]
                }
              ]
            },
