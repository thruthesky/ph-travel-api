            { "label": "ガイド付きシャトルツアー", "price": "約₱120〜200", "note": "約45分、先着順" },
            { "label": "スカイライダー", "price": "約₱200〜350", "note": "1回" },
            { "label": "スカイサイクル・スカイスウィング", "price": "約₱200〜500", "note": "種目・人数により異なる" },
            { "label": "乗馬・釣り", "price": "約₱100〜300", "note": "時間・釣果基準は別途" },
            { "label": "プール", "price": "約₱60〜100", "note": "日帰り客基準" },
            { "label": "市街–エデンタクシー", "price": "片道約₱600〜1,000", "note": "往復貸切推奨" },
            { "label": "山荘・コテージ宿泊", "price": "1泊約₱4,000〜6,500", "note": "2〜4人部屋、朝食込みプランが多い" }
          ]
        },
        {
          "type": "caption",
          "children": [
            { "text": "料金は" },
            { "type": "date", "text": "2026年" },
            { "text": "時点の目安であり、現地の状況により変わる場合があります。" }
          ]
        }
      ]
    },
    {
      "type": "section",
      "key": "stay_and_food",
      "title": "宿泊とグルメ",
      "icon": "restaurant",
      "blocks": [
        {
          "type": "paragraph",
          "children": [
            { "text": "公園内には松林の間に位置するコテージとロッジ型の客室があり、2人部屋は1泊約" },
            { "type": "price", "text": "₱4,000〜5,000" },
            { "text": "、4人家族部屋は約" },
            { "type": "price", "text": "₱5,000〜6,500" },
            {
