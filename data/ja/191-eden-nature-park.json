                      "children": [{ "text": "スカイライダー・スカイサイクルなど体験施設を利用(午前は待ち列が短い)" }]
                    },
                    { "time": "11:30〜13:00", "children": [{ "text": "レストランで昼食ビュッフェ、野菜畑と花の庭園を散策" }] },
                    { "time": "13:30", "children": [{ "text": "ティヌブダン先住民文化村、鹿の放牧場を見学" }] },
                    { "time": "14:30", "children": [{ "text": "乗馬や釣り、またはプールで休憩" }] },
                    { "time": "16:00", "children": [{ "text": "公園出発、トリルを経てダバオ市街へ戻る" }] }
                  ]
                }
              ]
            },
            {
              "title": "1泊2日",
              "subtitle": "山中で一泊",
              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    { "time": "1日目午前", "children": [{ "text": "ダバオ市街を出発、チェックイン後ガイド付きシャトルツアー" }] },
                    { "time": "1日目午後", "children": [{ "text": "体験施設の利用と森の小道の散策、夜は涼しい空気の中で食事" }] },
                    { "time": "2日目06:00", "children": [{ "text": "霧に包まれた早朝の松林散策と写真撮影" }] },
                    { "time": "2日目08:00", "children": [{ "text": "朝食後、野菜畑・ティヌブダンなどまだ見ていない場所を回る" }] },
                    {
                      "time": "2日目12:00",
                      "children": [{ "text": "チェックアウト後市街へ移動、午後はダバオ市街の日程を続ける" }]
                    }
                  ]
                }
              ]
            }
          ]
