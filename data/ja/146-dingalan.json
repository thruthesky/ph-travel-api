                    { "time": "13:00", "children": [{ "text": "ホワイトビーチでブードルファイトの昼食" }] },
                    { "time": "14:00〜16:00", "children": [{ "text": "水泳と休憩、船でラマオ海食洞窟を見て回る" }] },
                    { "time": "17:00", "children": [{ "text": "宿にチェックイン、海岸で夕方の散策" }] },
