                    { "time": "08:00〜10:30", "children": [{ "text": "滝で水泳と休憩" }] },
                    { "time": "11:30", "children": [{ "text": "昼食後チェックアウト" }] },
                    {
                      "time": "12:30",
                      "children": [{ "text": "カバナトゥアン行きのバン・バスに乗車(最終便の時間を事前に確認)" }]
