          "blocks": [
            {
              "type": "card",
              "title": "エンチャンテッド・リバー",
              "place": "enchanted-river",
              "children": [
                { "text": "車で約" },
                { "type": "duration", "text": "1時間30分" },
                { "text": "(ヒナトゥアン)。底が見えないサファイア色の泉へ続く川です。" }
              ]
            },
            {
              "type": "card",
              "title": "ブリタニア諸島",
              "place": "britania-islands",
              "children": [
                { "text": "車で約" },
                { "type": "duration", "text": "3〜4時間" },
                { "text": "(サンアグスティン)、バンカ島巡りツアー。小さな島が点在する澄んだ海で、普通は1日を別に取ります。" }
              ]
            },
            {
              "type": "card",
              "title": "シアルガオ",
              "place": "siargao",
              "children": [{ "text": "ブトゥアンとスリガオ市を経由して、船にも乗る必要があり、1日近くかかります。サーフィンと島巡りの島です。" }]
            },
            {
              "type": "card",
              "title": "ダバオ",
              "place": "davao-city",
              "children": [
                { "text": "バスで約" },
                { "type": "duration", "text": "4〜9時間" },
                { "text": "。アポ山とフィリピンワシセンター、ドリアンで有名なミンダナオ最大の都市です。" }
              ]
            },
            {
              "type": "card",
              "title": "ビスリグ・ベイウォーク",
              "children": [{ "text": "マンガゴイから近い海沿いの遊歩道で、滝の日程を終えた後、夕暮れ時の散歩に向いています。" }]
            }
          ]
        }
      ]
    }
  ]
}
