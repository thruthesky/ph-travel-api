                      "time": "午後5時",
                      "children": [
                        { "type": "place_link", "text": "トップス展望台", "slug": "tops-lookout" },
                        { "text": "へ移動して夕焼けと夜景を鑑賞。入場料は約" },
                        { "type": "price", "text": "₱100" },
                        { "text": "で、24時間営業です。" }
                      ]
                    },
                    { "time": "午後7時", "children": [{ "text": "市内へ戻る" }] }
                  ]
                },
                {
                  "type": "paragraph",
                  "children": [
