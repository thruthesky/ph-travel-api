            { "label": "島の入場料", "price": "1人約₱100", "note": "ビーチの受付で1回支払う。外国人は別料金という案内もある" },
            { "label": "シュノーケリング利用料", "price": "1人約₱100", "note": "ダイバーは入場料₱100+ダイビング₱200" },
            { "label": "ウミガメのガイド・機材", "price": "約₱300", "note": "グループ単位・1人単位と案内が分かれる。機材のレンタルは別" },
            { "label": "バンカーボートの移動", "price": "乗合は片道約₱300", "note": "往復チャーター約₱2,500〜4,000(3〜6人)" },
            {
              "label": "ダイブショップのシュノーケリングツアー",
