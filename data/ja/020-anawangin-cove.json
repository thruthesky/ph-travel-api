                    },
                    { "time": "07:00", "children": [{ "text": "標高464mのプンダキット山頂、アナワンギンと海を見下ろす" }] },
                    {
                      "time": "09:30",
                      "children": [{ "text": "草原の尾根を下り、モクマオウの林を抜けてアナワンギン到着、入場料を支払う" }]
                    },
                    { "time": "10:30", "children": [{ "text": "ボートで先に届いた荷物を受け取ってテント設営、昼食と昼寝" }] },
                    { "time": "15:00", "children": [{ "text": "海水浴と潟湖の散策" }] },
                    { "time": "16:30", "children": [{ "text": "展望台の丘に登り夕日を鑑賞" }] },
                    { "time": "2日目 07:00", "children": [{ "text": "朝食、テントの片付け" }] },
