            { "label": "島の入場料・小屋利用料", "price": "約₱50〜200", "note": "島ごとの少額料金、最新のお知らせを確認" },
            { "label": "島でのランチ", "price": "1人約₱200〜700", "note": "シーフードのグリルと調理代、ツアーに含まれる場合あり" },
            { "label": "スクーターレンタル", "price": "1日約₱350〜500", "note": "船着き場への移動用、燃料は別" },
            { "label": "宿泊(ドミトリー〜ゲストハウス)", "price": "1泊約₱600〜3,500", "note": "ジェネラルルナの目安" }
