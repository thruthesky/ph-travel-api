            },
            {
              "type": "card",
              "title": "ギンバル・ティグバウアン教会",
              "children": [
                { "text": "イロイロ市方面へ車で約" },
                { "type": "duration", "text": "15〜30分" },
                { "text": "、ギンバル教会(国の文化財、黄みがかった石造りのファサード)とティグバウアン教会(色とりどりの石のモザイクの内部)が同じ道沿いにあります" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
