                { "type": "duration", "text": "1時間" },
                { "text": "、バチョイと歴史的街並みのグルメ都市" }
              ]
            },
            {
              "type": "card",
              "title": "ギマラス島",
              "place": "guimaras",
              "children": [
                { "text": "イロイロのパロラ船着き場からバンカボートで約" },
                { "type": "duration", "text": "15分" },
                { "text": "、マンゴーとビーチの島" }
              ]
            },
            {
              "type": "card",
              "title": "サンホアキン教会とカンポ・サント",
              "children": [
                { "text": "南へ約" },
                { "type": "duration", "text": "15分" },
                { "text": "、戦闘の場面を刻んだファサードとバロック様式の墓地礼拝堂" }
              ]
            },
            {
              "type": "card",
              "title": "パオアイ教会",
