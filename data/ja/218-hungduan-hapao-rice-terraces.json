              "place": "maligcong-rice-terraces",
              "children": [
                { "text": "バナウェとボントックを経由して約" },
                { "type": "duration", "text": "3時間" },
                { "text": "、石積みの田と雲海の日の出が美しい村です。" }
              ]
            }
          ]
        }
      ]
    }
  ]
