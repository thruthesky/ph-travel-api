            { "label": "ジップライン", "price": "約₱350〜500", "note": "1人、2区間" },
            { "label": "湖ボートツアー", "price": "約₱400〜800", "note": "1隻、約1時間" },
            { "label": "博物館・工房訪問", "price": "約₱20〜100", "note": "1人、寄付金形式を含む" },
            { "label": "宿泊", "price": "約₱1,200〜3,500", "note": "1室1泊" },
