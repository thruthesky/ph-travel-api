                { "text": "タクシーで約" },
                { "type": "duration", "text": "10〜20分" },
                { "text": "、松林の散策路とベル・ハウスの歴史地区がある元米軍保養地です。" }
              ]
            },
            {
              "type": "card",
              "title": "バーナム公園",
              "place": "burnham-park-baguio",
              "children": [
                { "text": "約" },
                { "type": "distance", "text": "3〜4km" },
                { "text": "、タクシーで" },
                { "type": "duration", "text": "10〜15分" },
                { "text": "。マンションと同じバーナムの都市計画から生まれた中心部の湖の公園です。" }
              ]
            },
            {
              "type": "card",
              "title": "バギオ植物園",
              "children": [
                { "text": "レナード・ウッド・ロードを歩いて約" },
                { "type": "duration", "text": "10分" },
                { "text": "、吊り橋とイゴロットの小屋がある森の庭園です。" }
              ]
            },
            {
              "type": "card",
              "title": "ラ・トリニダードのイチゴ農園",
              "place": "la-trinidad-strawberry-farm",
              "children": [
                { "text": "車で約" },
                { "type": "duration", "text": "30〜50分" },
                { "text": "、旬の時期にはイチゴ狩りが楽しめるベンゲット州の高原農園です。" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
