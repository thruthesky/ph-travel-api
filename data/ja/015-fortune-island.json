                    { "time": "08:00", "children": [{ "text": "灯台まで約30分歩いて登り、島の眺望を楽しむ" }] },
                    { "time": "09:30", "children": [{ "text": "シュノーケリングとクリフダイビング" }] },
                    { "time": "12:00", "children": [{ "text": "持参した弁当で昼食、ビーチの日陰で休憩" }] },
