                    { "time": "1日目19:00", "children": [{ "text": "民宿で夕食、早めの就寝" }] },
                    { "time": "2日目06:00", "children": [{ "text": "夜明けの霧が晴れていく棚田の風景を鑑賞" }] },
                    { "time": "2日目07:30", "children": [{ "text": "朝食後に村を散策" }] },
