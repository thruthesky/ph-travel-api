            ["6月〜7月", "雨季、午後のスコールと霧", "黄金色の稲の収穫 — 余裕のある日程を組む"],
            ["8月〜11月", "雨季(10月まで)、土砂崩れの危険", "水を張った田が空を映す — 畦の曲線が鮮明"]
          ]
        }
      ]
    },
