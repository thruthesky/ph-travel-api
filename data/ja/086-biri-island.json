                    },
                    { "time": "17:30", "children": [{ "text": "海岸で夕日鑑賞、民宿でシーフードの夕食" }] }
                  ]
                }
              ]
            },
            {
              "title": "2日目",
              "subtitle": "奇岩地形を一周して戻る",
              "blocks": [
                {
                  "type": "stepper",
