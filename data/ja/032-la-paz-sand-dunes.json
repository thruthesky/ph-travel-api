                  ]
                }
              ]
            },
            {
              "title": "1日コース(イロコス・ノルテ南部)",
              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    { "time": "08:00", "children": [{ "text": "ラオアグを出発、バタックのマルコス大統領記念館" }] },
                    { "time": "10:00", "children": [{ "text": "パオアイ教会と北マラカニアン宮殿" }] },
                    { "time": "12:00", "children": [{ "text": "パオアイで昼食" }] },
                    { "time": "13:30", "children": [{ "text": "ラオアグに戻って市街観光" }] },
                    { "time": "15:30", "children": [{ "text": "ラパス砂丘4WDツアー" }] },
