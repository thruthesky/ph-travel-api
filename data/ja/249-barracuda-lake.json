              ]
            },
            {
              "type": "card",
              "title": "カヤンガン湖",
              "place": "kayangan-lake",
              "children": [
                { "text": "東へ約" },
                { "type": "distance", "text": "800m" },
                { "text": "離れたコロン島を代表する湖です。展望台から見下ろすラグーンの景色が有名で、ツアーAやスーパー・アルティメットツアーで一緒に行けます。" }
              ]
            },
            {
              "type": "card",
              "title": "コロン",
              "place": "coron",
              "children": [
                { "text": "ボートで約" },
                { "type": "duration", "text": "20〜30分" },
                { "text": "の、ツアーの出発地です。第二次世界大戦の沈船ダイビングやタピアス山の夕日、マキニット温泉を一緒に楽しめます。" }
              ]
            },
            {
              "type": "card",
              "title": "クリオン島",
              "place": "culion",
              "children": [
                { "text": "コロンの町から高速船で約" },
                { "type": "duration", "text": "45分〜1時間" },
                { "text": "の南の島です。20世紀初めにハンセン病療養所があった歴史ある町と静かな海を日帰りで巡ります。" }
              ]
            }
          ]
        }
      ]
    }
  ]
