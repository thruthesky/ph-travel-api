            {
              "title": "半日コース",
              "subtitle": "飛行機の時間前に要点だけを見て回る日程",
              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    {
                      "time": "06:30",
                      "children": [
                        { "text": "カグサワ遺跡に到着、鐘楼とマヨンを撮影(入場料約" },
                        { "type": "price", "text": "₱100" },
                        { "text": ")" }
                      ]
                    },
                    {
                      "time": "07:30",
                      "children": [
                        { "text": "草原コースのATV約" },
                        { "type": "duration", "text": "30分" },
                        { "text": "(約" },
                        { "type": "price", "text": "₱500" },
                        { "text": ")" }
                      ]
                    },
                    { "time": "09:00", "children": [{ "text": "ダラガ教会、丘の上の教会前の階段からマヨンを正面に眺める" }] },
                    { "time": "10:30", "children": [{ "text": "レガスピ市街へ移動し、ビコール・エクスプレスやラエンで昼食" }] },
                    { "time": "12:00", "children": [{ "text": "海岸ブールバードの散策またはリニョン・ヒル展望台" }] },
                    {
                      "time": "14:00",
                      "children": [
                        { "text": "ビコール国際空港へ移動(市街から約" },
                        { "type": "duration", "text": "30〜40分" },
                        { "text": ")、出発の2時間前までに到着" }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "title": "3日目 ドンソル日帰り",
              "subtitle": "ジンベエザメのシーズンのみ",
              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    {
                      "time": "06:00",
                      "children": [
                        { "text": "レガスピ市街のバンターミナルからドンソル行きのバンに乗車(約" },
                        { "type": "duration", "text": "1時間30分" },
                        { "text": ")" }
                      ]
                    },
                    { "time": "08:00", "children": [{ "text": "ドンソルのビジターセンターで登録と安全講習、ガイドの割り当て" }] },
                    {
                      "time": "09:00",
                      "children": [
                        { "text": "ボートに乗ってジンベエザメを探す(シーズンは" },
                        { "type": "date", "text": "11月〜6月" },
                        { "text": "、" },
                        { "type": "date", "text": "2〜4月" },
                        { "text": "が最適)" }
                      ]
                    },
                    { "time": "13:00", "children": [{ "text": "昼食後、レガスピに戻る" }] },
                    {
                      "children": [
                        { "text": "ドンソルのシーズン・費用・ホタルの川クルーズは" },
                        { "type": "place_link", "text": "ドンソル", "slug": "donsol" },
                        { "text": "の旅行先ページで詳しく見られます。ジンベエザメに二度挑戦するなら、ドンソルで1泊するのがおすすめです。" }
                      ]
                    }
