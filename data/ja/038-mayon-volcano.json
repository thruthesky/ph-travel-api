                    { "children": [{ "text": "ダラガ教会や市内の教会、工芸品店を巡る" }] },
                    { "children": [{ "text": "SM City Legazpiなど市内のショッピングモールで休憩と食事" }] },
                    { "children": [{ "text": "食堂でビコール・エクスプレス、ラエン、ピナンガットを味わい、ビコール料理を食べ比べる" }] },
                    { "children": [{ "text": "空が晴れる明け方や夕暮れ時に、海岸ブールバードでマヨンを確認する" }] }
