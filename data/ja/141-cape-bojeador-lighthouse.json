            { "label": "マニラ〜ラオアグ間の航空券", "price": "片道約₱2,000〜6,000", "note": "時期・予約時期により異なる" },
            { "label": "ラオアグ〜ブルゴス間のバス", "price": "片道約₱70〜120", "note": "パグドゥプッド方面バス" },
            { "label": "シャトルトライシクル", "price": "1人片道約₱10〜20", "note": "駐車場〜灯台間" },
            { "label": "入場料・寄付金", "price": "約₱0〜50", "note": "時期により異なる、最新の告知を確認" },
            { "label": "車貸し切り(北部ツアー)", "price": "1台約₱2,500〜4,500", "note": "運転手込み、人数で割り勘" },
            { "label": "食事", "price": "1食約₱150〜400", "note": "ラオアグ・パグドゥプッドの食堂基準" },
            { "label": "ビスコチョなどの軽食", "price": "約₱50〜200", "note": "パスキンのパン屋" }
          ]
