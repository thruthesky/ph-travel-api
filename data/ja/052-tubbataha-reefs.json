              "title": "プエルト・プリンセサ地底河川",
              "place": "puerto-princesa-underground-river",
              "children": [
                { "text": "プエルト・プリンセサから車で約" },
                { "type": "duration", "text": "2時間" },
                { "text": "、ユネスコ世界遺産の地底河川ボートツアー" }
              ]
            },
            {
              "type": "card",
              "title": "ホンダ湾",
              "place": "honda-bay",
              "children": [
                { "text": "プエルト・プリンセサ市内から約" },
                { "type": "duration", "text": "30分" },
                { "text": "、下船後に気軽に楽しめる島ホッピング" }
              ]
            },
            {
              "type": "card",
              "title": "エルニド",
              "place": "el-nido",
              "children": [
                { "text": "プエルト・プリンセサからバンで約" },
                { "type": "duration", "text": "5〜6時間" },
                { "text": "、石灰岩の断崖とラグーン" }
              ]
            },
            {
              "type": "card",
              "title": "コロン",
              "place": "coron",
              "children": [
                { "text": "プエルト・プリンセサから2GO客船(週1回)、またはマニラ・クラーク経由の航空便で連絡、第二次世界大戦の沈没船ダイビングの聖地" }
              ]
            }
          ]
        }
      ]
    }
  ]
