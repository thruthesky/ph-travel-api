                    { "time": "10:30", "children": [{ "text": "農場エリアを見学し、サンホアキン教会に立ち寄る" }] },
                    { "time": "12:30", "children": [{ "text": "イロイロ市へ戻る、またはギマラス行きの船に接続" }] }
