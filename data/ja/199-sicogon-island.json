            { "label": "宿泊", "price": "1泊約₱800〜3,000", "note": "集落の民宿・本土の宿" },
            { "label": "食事", "price": "1食約₱150〜400", "note": "民宿で注文する食事、ホタテは別料金" }
          ]
        },
