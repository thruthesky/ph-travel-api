                      "children": [{ "text": "バレル教会で包囲戦の歴史を伝える標識を見て、すぐ隣のケソン公園を散策" }]
                    },
                    {
                      "time": "11:15",
                      "children": [{ "text": "ムセオ・デ・バレルで包囲戦の展示とケソン大統領の遺品を見学(環境観光税のチケットで入場)" }]
                    },
                    { "time": "12:00", "children": [{ "text": "近くのドニャ・アウロラ・ケソン生家の復元家屋を見学" }] },
                    { "time": "12:30", "children": [{ "text": "市内のレストランで昼食" }] },
                    {
                      "time": "14:00",
                      "children": [{ "text": "トライシクルでエルミタの丘に上り、トロンバ・マリナのモニュメントとバレル湾の眺めを楽しむ" }]
