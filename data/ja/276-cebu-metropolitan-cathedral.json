                      "children": [
                        { "text": "徒歩" },
                        { "type": "duration", "text": "5〜10分" },
                        { "text": "のパリアン地区にあるセブ・ヘリテージ記念碑を見物" }
                      ]
                    },
                    { "time": "17:30", "children": [{ "text": "大聖堂に戻り、夕暮れのファサードと鐘楼を撮影" }] },
                    {
                      "time": "18:00",
                      "children": [
                        { "text": "平日の夕方のミサを見学（日曜日は" },
