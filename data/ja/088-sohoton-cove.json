                      ]
                    },
                    { "time": "09:00", "children": [{ "text": "ソコロ観光事務所で登録、環境税の支払い、ガイド乗船" }] },
                    { "time": "09:30", "children": [{ "text": "干潮の時間に合わせて洞窟入口を通過、潟湖でカヤックと水泳" }] },
                    { "time": "11:00", "children": [{ "text": "クラゲの湖でシュノーケリング" }] },
                    { "time": "12:30", "children": [{ "text": "島の小屋でシーフードの昼食" }] },
                    { "time": "13:30", "children": [{ "text": "ハグカン洞窟・マククコップ洞窟の探検と崖ジャンプ" }] },
                    { "time": "15:00", "children": [{ "text": "帰路出発" }] },
                    { "time": "17:30", "children": [{ "text": "ジェネラルルナ到着" }] }
                  ]
                }
              ]
            },
            {
