                { "text": "、湖のボートやサイクリングを楽しめる市街地の公園です。" }
              ]
            },
            {
              "type": "card",
              "title": "マインズビュー・パークとライト公園",
              "children": [
                { "text": "タクシーで" },
                { "type": "duration", "text": "15〜20分" },
                { "text": "、旧鉱山の谷を望む展望台と、ポニーに乗れる松林の公園です。" }
              ]
            },
            {
              "type": "card",
              "title": "ラ・トリニダードのイチゴ農園",
              "place": "la-trinidad-strawberry-farm",
              "children": [
                { "text": "車で" },
                { "type": "duration", "text": "30〜50分" },
                { "text": "、イチゴ狩りと高原野菜の市場を楽しめるベンゲット州の農園です。" }
              ]
            }
          ]
        }
      ]
    }
  ]
