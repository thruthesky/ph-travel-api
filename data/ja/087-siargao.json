                    {
                      "time": "15:00",
                      "children": [{ "text": "デルカルメンのマングローブ展望台に立ち寄った後ジェネラルルナへ戻る" }]
                    }
                  ]
                }
              ]
            },
            {
              "title": "4日目",
              "subtitle": "島北部一周",
              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    { "time": "08:00", "children": [{ "text": "オートバイでヤシ林展望台、マアシン川のブランコを訪問" }] },
                    { "time": "11:00", "children": [{ "text": "干潮の時間に合わせてマクププンコ岩の水たまり" }] },
                    { "time": "13:00", "children": [{ "text": "ピラールで昼食後、パシフィコビーチまでドライブ" }] },
