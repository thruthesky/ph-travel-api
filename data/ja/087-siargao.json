                        { "text": "前の出発を推奨)" }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "key": "getting_there",
      "title": "アクセス",
      "icon": "directions",
      "blocks": [
        {
          "type": "accordion",
          "items": [
            {
              "title": "飛行機",
              "icon": "flight",
              "blocks": [
                {
                  "type": "paragraph",
                  "children": [
                    { "text": "マニラ(NAIA)〜シアルガオ直行便は、" },
                    { "type": "date", "text": "2025年3月" },
                    { "text": "に小型プロペラ機路線がクラーク空港に移ったことでなくなりました。マニラからはセブを経由するか(セブ〜シアルガオ約" },
                    { "type": "duration", "text": "1時間" },
                    { "text": ")、クラーク空港からセブパシフィック系列の直行便(約" },
                    { "type": "duration", "text": "2時間20分〜2時間30分" },
                    { "text": ")に乗ります。ダバオからも直行便があります(約" },
                    { "type": "duration", "text": "1時間10分" },
                    { "text": ")。航空運賃は片道約" },
                    { "type": "price", "text": "₱2,000〜5,000" },
                    {
                      "text": "ですが、繁忙期には大きく上がり、路線と便数がよく変わるため、予約前に確認します。空港はデルカルメンにあり、ジェネラルルナまで乗合バンで約"
                    },
                    { "type": "duration", "text": "45分〜1時間" },
                    { "text": "、1人約" },
                    { "type": "price", "text": "₱300〜400" },
                    { "text": "です。宿の送迎やチャーターバンは1台約" },
                    { "type": "price", "text": "₱2,000〜2,700" },
                    { "text": "です。" }
                  ]
                }
              ]
            },
            {
              "title": "船",
              "icon": "directions_boat",
              "blocks": [
                {
                  "type": "paragraph",
                  "children": [
                    {
                      "text": "航空券が高かったり満席だったりする場合は、スリガオ市を経由する方法があります。セブなどからスリガオ空港(SUG)へ、またはマニラ・セブからブトゥアン空港(BXU)へ行った後、スリガオ港からシアルガオのダパ港まで高速船(約"
                    },
                    { "type": "duration", "text": "1時間30分〜2時間" },
                    { "text": "、約" },
                    { "type": "price", "text": "₱350〜700" },
                    { "text": ")またはロロ船(約" },
                    { "type": "duration", "text": "3〜4時間" },
                    { "text": ")に乗ります。ダパ港からジェネラルルナまではバンやトライシクルで約" },
                    { "type": "duration", "text": "30〜40分" },
                    { "text": "です。セブからスリガオまでの夜行客船(約" },
                    { "type": "duration", "text": "8〜10時間" },
                    { "text": ")も運航しています。" }
                  ]
                }
              ]
            },
            {
              "title": "島内の移動",
              "icon": "commute",
              "blocks": [
                {
                  "type": "paragraph",
                  "children": [
                    { "text": "島内ではスクーターレンタル(1日約" },
                    { "type": "price", "text": "₱350〜500" },
                    { "text": ")が最も一般的です。運転が不安なら、トライシクルやハバルハバルを利用し、島北部一周は運転手付きバン(1日約" },
                    { "type": "price", "text": "₱3,000〜4,500" },
                    { "text": ")を借りる方法もあります。ホッピングツアーとスグバラグーンツアーは、ほとんどが宿泊先ピックアップ込みの商品として販売されます。" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "key": "best_time",
      "title": "ベストシーズンと天気",
      "icon": "wb_sunny",
      "blocks": [
        {
          "type": "paragraph",
          "children": [
            { "text": "シアルガオは太平洋に直接面しており、雨が多めです。" },
            { "type": "date", "text": "11月" },
            { "text": "から" },
            { "type": "date", "text": "2月" },
            { "text": "までは北東季節風(アミハン)で雨が多く海も荒れ、ホッピングツアーが中止になる日があります。" },
            { "type": "date", "text": "3月" },
            { "text": "から" },
            { "type": "date", "text": "10月" },
            { "text": "までは相対的に乾燥しており、特に" },
            { "type": "date", "text": "3〜6月" },
            { "text": "は海が穏やかで空も晴れ、ホッピング・ラグーンツアーに最も適しています。" }
          ]
        },
        {
          "type": "paragraph",
          "children": [
            { "text": "サーフィンは季節ごとに性格が異なります。" },
            { "type": "date", "text": "8月" },
            { "text": "から" },
            { "type": "date", "text": "11月" },
            { "text": "の間に大きなうねりが入り、クラウドナインが最も良い波を見せてくれ、この時期の" },
            { "type": "date", "text": "9〜10月" },
            { "text": "頃にシアルガオ国際サーフィン大会が開かれます。反対に" },
            { "type": "date", "text": "3〜6月" },
            { "text": "は波が小さく初心者講習に向いています。台風はフィリピンの他地域より頻度が低いですが、" },
            { "type": "date", "text": "2021年" },
            { "text": "のオデットのように" },
            { "type": "date", "text": "12月" },
            { "text": "に強い台風が通過することもあるため、雨季の旅行時は予報を確認します。" }
          ]
        },
        {
          "type": "table",
          "label": "時期別ひと目でわかる表",
          "icon": "calendar_month",
          "columns": ["時期", "天気", "旅のポイント"],
          "rows": [
