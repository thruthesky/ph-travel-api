                  "type": "stepper",
                  "items": [
                    {
                      "time": "10:00",
                      "children": [
                        { "text": "サヤク空港到着、乗合バンでジェネラルルナへ移動(約" },
                        { "type": "duration", "text": "45分〜1時間" },
                        { "text": ")" }
                      ]
                    },
                    { "time": "12:00", "children": [{ "text": "宿にチェックイン、ツーリズムロードのカフェで昼食" }] },
                    { "time": "14:00", "children": [{ "text": "クラウドナインの木道散策とサーフィン見物" }] },
                    {
                      "time": "16:00",
                      "children": [
                        { "text": "初心者サーフィン講習(約" },
                        { "type": "duration", "text": "1〜2時間" },
                        { "text": ")" }
                      ]
                    },
                    { "time": "18:00", "children": [{ "text": "ビーチで日没鑑賞、ジェネラルルナのレストラン街で夕食" }] }
