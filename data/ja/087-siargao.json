                    { "time": "08:30", "children": [{ "text": "ネイキッド島の砂州散策と写真撮影" }] },
                    { "time": "10:00", "children": [{ "text": "ダク島で水泳、シーフードバーベキューの昼食" }] },
                    { "time": "13:00", "children": [{ "text": "グヤム島を一周散策" }] },
                    { "time": "15:00", "children": [{ "text": "帰着後休憩、夕方はサーフィンまたはヨガ" }] }
