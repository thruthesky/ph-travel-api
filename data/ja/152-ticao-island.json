                    {
                      "time": "午前",
                      "children": [{ "text": "モンレアルからピラール行きの船、またはラグンディからマスバテ・シティ行きの船" }]
                    },
                    { "time": "午後", "children": [{ "text": "ドンソルかレガスピへ移動" }] }
                  ]
