                    { "time": "08:00", "children": [{ "text": "モンレアル港からバンカーボートで出発、ハレア島とボロバンカソ" }] },
                    { "time": "昼食", "children": [{ "text": "砂の島でシーフードバーベキューの昼食" }] },
                    { "time": "午後", "children": [{ "text": "海路でカタンダヤガン滝を訪れた後、帰還" }] }
