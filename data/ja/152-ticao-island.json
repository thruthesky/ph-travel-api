            { "label": "ファンダイビング", "price": "約₱1,800〜2,500", "note": "1本、器材レンタルは別料金のことがある" },
            { "label": "マンタ・ボウル ダイビング", "price": "約₱2,500〜3,500", "note": "1本、ボート代込み" },
            { "label": "島巡りのバンカーボート", "price": "約₱2,000〜2,500", "note": "1隻5人まで、ガイド料約₱500別" },
            { "label": "ハレア島入場料", "price": "約₱100", "note": "1人、環境税別" },
            { "label": "宿泊", "price": "約₱1,000〜5,000", "note": "1泊、民宿〜ダイブリゾート" },
            { "label": "食事", "price": "約₱400〜900", "note": "1人1日" }
          ]
        },
        {
          "type": "caption",
          "children": [
            { "text": "料金は" },
            { "type": "date", "text": "2026年" },
            { "text": "時点の目安で、現地の状況により変わる場合があります。" }
