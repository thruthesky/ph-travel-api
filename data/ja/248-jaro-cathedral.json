                { "text": "南西へ車で約" },
                { "type": "duration", "text": "1時間〜1時間30分" },
                { "text": "、ユネスコ世界遺産のバロック様式の要塞教会" }
              ]
            },
            {
              "type": "card",
              "title": "ギマラス島",
              "place": "guimaras",
              "children": [
                { "text": "市内のパロラ船着き場からバンカボートで約" },
                { "type": "duration", "text": "15分" },
                { "text": "、マンゴーとビーチの島" }
              ]
            }
          ]
        }
      ]
    }
  ]
