                      ]
                    },
                    { "time": "10:30〜11:15", "children": [{ "text": "地底河川ボートツアー" }] },
                    { "time": "12:00", "children": [{ "text": "サバン埠頭に戻り、ビーチの食堂で昼食" }] },
                    { "time": "13:30", "children": [{ "text": "マングローブ・パドルボートツアーまたはサバンビーチで休憩" }] },
                    { "time": "15:00", "children": [{ "text": "プエルト・プリンセサへ出発" }] },
                    { "time": "17:00", "children": [{ "text": "市内到着、夕食" }] }
                  ]
                }
              ]
            },
            {
              "title": "1泊2日(サバンで1泊)",
              "subtitle": "早い時間の最初のボートを狙うコース",
              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    {
                      "time": "1日目午前",
                      "children": [{ "text": "プエルト・プリンセサ市内の予約事務所で、翌日の許可証の日付と名前を確認します。" }]
                    },
                    {
                      "time": "1日目午後",
                      "children": [
                        { "text": "イラワン・ターミナルからサバン行きのバンに乗って約" },
                        { "type": "duration", "text": "2時間〜2時間30分" },
                        { "text": "移動し、サバンで荷物を置いて落ち着きます。" }
                      ]
                    },
                    {
                      "time": "1日目夕方",
                      "children": [{ "text": "西の海に面したサバンビーチで夕日を眺め、ビーチの食堂で焼き魚の夕食をとります。" }]
                    },
                    {
                      "time": "午前8時",
                      "children": [
                        { "text": "サバン埠頭の受付で許可証を提出して料金を支払い、ボートの番号札を受け取ります。早めに並べば待ち時間が短くて済みます。" }
                      ]
                    },
                    {
                      "time": "09:00",
                      "children": [
                        { "text": "バンカボートで洞窟入り口のビーチまで約" },
                        { "type": "duration", "text": "15〜20分" },
                        { "text": "移動します。" }
                      ]
                    },
                    {
                      "time": "09:30",
                      "children": [
                        { "text": "地底河川ボートツアーに参加します。約" },
