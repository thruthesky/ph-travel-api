                        { "type": "price", "text": "₱25〜35" },
                        { "text": "、約" },
                        { "type": "duration", "text": "40〜50分" },
                        { "text": ")" }
                      ]
                    },
                    {
                      "time": "08:00",
                      "children": [
                        { "text": "サンタ・ルルデスの交差点から埠頭まで約" },
                        { "type": "distance", "text": "1〜2km" },
                        { "text": "、徒歩またはトライシクル" }
                      ]
                    },
