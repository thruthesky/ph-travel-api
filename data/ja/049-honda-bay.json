                { "type": "duration", "text": "30分" },
                { "text": "の距離で、夜にマングローブ林のホタルを見ます。" }
              ]
            },
            {
              "type": "card",
              "title": "ポートバートン",
              "place": "port-barton",
              "children": [
                { "text": "市内からバンで約" },
                { "type": "duration", "text": "3〜4時間" },
                { "text": "の距離の静かなビーチの町で、閑静なアイランドホッピングを楽しめます。" }
              ]
            },
            {
              "type": "card",
              "title": "エルニド",
              "place": "el-nido",
              "children": [
                { "text": "市内からバンで約" },
                { "type": "duration", "text": "5〜6時間" },
                { "text": "の距離の石灰岩の断崖とラグーンのリゾート地です。" }
              ]
            },
            {
              "type": "card",
              "title": "プエルト・プリンセサ市",
              "place": "puerto-princesa",
              "children": [
                { "text": "埠頭から車で約" },
                { "type": "duration", "text": "30分" },
                { "text": "の距離にあるパラワンの州都で、空港・ベイウォーク・市場・宿が集まっているため、ツアーの前後の拠点に最適です。" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
