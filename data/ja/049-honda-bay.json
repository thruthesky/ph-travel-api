              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    {
                      "time": "08:00",
                      "children": [{ "text": "サンタ・ルルデス埠頭に到着、環境税とターミナル料金を納付、船主協会の売り場でコースBを選択" }]
                    },
                    {
                      "time": "08:30",
                      "children": [
                        { "text": "バンカボート出発、スターフィッシュ島まで約" },
                        { "type": "duration", "text": "20分" }
                      ]
                    },
                    { "time": "09:00", "children": [{ "text": "スターフィッシュ島 — 浅い海でヒトデ観察と水泳" }] },
                    {
                      "time": "10:15",
                      "children": [
                        { "text": "ルリ島へ移動(約" },
                        { "type": "duration", "text": "10〜15分" },
                        { "text": ")、砂州散策とシュノーケリング" }
                      ]
                    },
                    {
                      "time": "11:30",
                      "children": [
                        { "text": "カウリー島へ移動(約" },
                        { "type": "duration", "text": "10分" },
                        { "text": ")、ビュッフェの昼食と休憩" }
                      ]
                    },
                    {
                      "time": "12:30",
