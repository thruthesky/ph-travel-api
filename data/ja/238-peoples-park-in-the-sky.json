              "type": "card",
              "title": "タガイタイ",
              "place": "tagaytay",
              "children": [
                { "text": "ロトンダまで車で約" },
                { "type": "duration", "text": "20〜30分" },
                { "text": "。尾根の展望カフェやブラロ、スカイランチの観覧車が集まる高原都市です。" }
              ]
            },
            {
              "type": "card",
              "title": "タガイタイ・ピクニック・グローブ",
              "children": [
                { "text": "同じカランバ道路沿いに車で約" },
                { "type": "duration", "text": "10分" },
                { "text": "。湖側の斜面に展望台や小屋の休憩所、森の散策路がある市立公園です。" }
              ]
            },
            {
              "type": "card",
              "title": "タール・ヘリテージタウン",
              "place": "taal-heritage-town",
              "children": [
                { "text": "車で約" },
                { "type": "duration", "text": "1〜1時間30分" },
                { "text": "。スペイン時代の大聖堂や古い邸宅が残るバタンガス州の歴史ある町です。" }
              ]
            },
            {
              "type": "card",
              "title": "カランバのリサール生家",
              "place": "rizal-shrine-calamba",
              "children": [
                { "text": "タガイタイ〜カランバ道路を通って車で約" },
                { "type": "duration", "text": "1時間" },
                { "text": "。フィリピンの国民的英雄ホセ・リサールが生まれた家を復元した記念館です。" }
              ]
            },
            {
              "type": "card",
              "title": "エンチャンテッド・キングダム",
              "place": "enchanted-kingdom",
              "children": [
                { "text": "サンタ・ロサ方面へ車で約" },
                { "type": "duration", "text": "45分〜1時間" },
                { "text": "。フィリピンを代表するテーマパークで、子ども連れなら1日過ごすのにぴったりです。" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
