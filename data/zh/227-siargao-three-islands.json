            { "label": "机场–赫纳勒尔卢纳合乘面包车", "price": "每人约₱300~400", "note": "约45分钟至1小时" },
            { "label": "三岛跳岛游（拼团）", "price": "每人约₱1,000~2,200", "note": "是否含午餐因旅行社而异，请确认" },
            { "label": "包船", "price": "每艘约₱1,500起", "note": "2023年一篇游记中5~6人的价格，可议价，现在多有上涨" },
            { "label": "岛上门票与木屋使用费", "price": "约₱50~200", "note": "各岛收取少量费用，请确认最新公告" },
            { "label": "岛上午餐", "price": "每人约₱200~700", "note": "烧烤海鲜与烹饪费，有时已包含在行程中" },
            { "label": "摩托车租借", "price": "每天约₱350~500", "note": "用于前往码头，油费另计" },
            { "label": "住宿（多人间至民宿）", "price": "每晚约₱600~3,500", "note": "赫纳勒尔卢纳一带" }
