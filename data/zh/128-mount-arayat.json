              ]
            },
            {
              "type": "card",
              "title": "皮纳图博火山",
              "place": "mount-pinatubo",
              "children": [
                { "text": "车程约" },
                { "type": "duration", "text": "1小时30分钟" },
                { "text": "抵达出发地卡帕斯，登上从阿拉亚特山顶眺望过的那座火山的火山口湖。" }
              ]
            },
            {
              "type": "card",
              "title": "米纳伦高国家公园",
              "place": "minalungao",
              "children": [
                { "text": "车程约" },
                { "type": "duration", "text": "2小时" },
                { "text": "，是新怡诗夏一处峡谷，绿色河水在石灰岩峭壁间流淌。" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
