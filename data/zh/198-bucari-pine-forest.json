            { "label": "伊洛伊洛市–莱昂吉普尼", "price": "单程约₱50~70", "note": "约1小时至1小时30分钟" },
            { "label": "莱昂–布卡里吉普尼", "price": "单程约₱60~80", "note": "下午较早时间收班" },
            { "label": "哈巴哈巴", "price": "单程约₱250~400", "note": "莱昂广场–营地，包车需议价" },
            { "label": "环境税", "price": "约₱50~100", "note": "每人，非当地居民标准" },
            { "label": "营地·曼西加门票", "price": "约₱30~50", "note": "每人" },
            { "label": "瀑布门票", "price": "约₱30~50", "note": "伊莫伊·卡陶瀑布，每人" },
            { "label": "帐篷位·帐篷租借", "price": "约₱100~500", "note": "场地使用费与租借费分开计算" },
            { "label": "小屋·民宿", "price": "每晚约₱1,500~3,500", "note": "4~8人共用标准" },
            { "label": "餐食", "price": "每餐约₱150~350", "note": "摊位·订餐" }
          ]
