            { "label": "帕罗拉↔乔丹方卡", "price": "每人约₱40", "note": "约15~20分钟，晚上8点以后₱50" },
            { "label": "环岛三轮摩托车包租", "price": "每天约₱1,200~2,500", "note": "视路线·人数而定" },
            { "label": "拼车吉普尼·多功能小卡", "price": "每次约₱40~80", "note": "乔丹↔新瓦伦西亚" },
            { "label": "岛屿跳岛游船", "price": "每船约₱1,000~2,000", "note": "阿卢比霍德出发" },
            { "label": "景点门票", "price": "每处约₱20~100", "note": "含海滩·保护区环境保护费" },
            { "label": "海滨度假村住宿", "price": "每晚约₱1,500~4,500", "note": "新瓦伦西亚一带" },
            { "label": "餐费", "price": "每餐约₱200~500", "note": "芒果披萨每份约₱300~600" },
