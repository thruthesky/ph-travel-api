            { "label": "马尼拉–圣费尔南多巴士", "price": "单程约₱150–250", "note": "以空调巴士为准" },
            { "label": "克拉克机场–市区出租车·Grab", "price": "单程约₱600–1,000", "note": "视时段而定" },
            { "label": "NLEX过路费", "price": "单程约₱250–350", "note": "以小客车为准" },
            { "label": "市区吉普尼·三轮摩托车", "price": "每次约₱14~80", "note": "视距离而定" },
            { "label": "观赏巨型彩灯", "price": "免费", "note": "竞赛座位安排每年不同" },
            { "label": "住宿", "price": "每晚约₱1,500–4,500", "note": "市区酒店至商场周边酒店" },
            { "label": "餐食", "price": "每餐约₱150–500", "note": "以传统美食餐厅为准" },
            { "label": "帕罗尔（彩灯）纪念品", "price": "约₱300–3,000", "note": "视大小与材质而定" },
            { "label": "包车", "price": "每天约₱3,000–4,500", "note": "串联巴科洛尔·阿拉亚特时" }
          ]
