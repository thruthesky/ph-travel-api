              ]
            },
            {
              "type": "card",
              "title": "马基灵山与洛斯巴尼奥斯",
              "place": "mount-makiling",
              "children": [
                { "text": "驱车约" },
                { "type": "duration", "text": "1小时" },
                { "text": "。以温泉度假村、森林徒步和布科派闻名。" }
              ]
            },
            {
              "type": "card",
              "title": "卢克班",
              "place": "lucban",
              "children": [
                { "text": "驱车约" },
                { "type": "duration", "text": "1小时~1小时30分钟" },
                { "text": "。以帕希亚斯节和朗加尼萨香肠闻名的奎松省山脚小镇。" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
