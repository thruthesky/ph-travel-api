              "type": "card",
              "title": "卡瓦山瀑布",
              "place": "kawasan-falls",
              "children": [
                { "text": "乘车约" },
                { "type": "duration", "text": "30分钟" },
                { "text": "，是巴迪安一处以青绿色瀑布和溯溪闻名的峡谷。" }
              ]
            },
            {
              "type": "card",
              "title": "奥斯洛布",
              "place": "oslob",
              "children": [
                { "text": "乘车约" },
                { "type": "duration", "text": "2小时~2小时30分钟" },
                { "text": "，是宿务南部可以与鲸鲨同游的渔村。" }
              ]
            },
            {
              "type": "card",
              "title": "奥斯梅纳峰",
              "place": "osmena-peak",
              "children": [
                { "text": "乘车约" },
                { "type": "duration", "text": "1小时30分钟~2小时" },
                { "text": "，是宿务最高峰，尖峭的山峰如波浪般连绵起伏。" }
              ]
            },
            {
              "type": "card",
              "title": "杜马格特",
              "place": "dumaguete",
              "children": [
                { "text": "乘巴士到巴托港约" },
                { "type": "duration", "text": "1小时30分钟" },
                { "text": "，再乘渡轮约" },
                { "type": "duration", "text": "30分钟~1小时" },
                { "text": "即可抵达，是内格罗斯东方省的大学城，也是阿波岛潜水的据点。" }
              ]
            }
          ]
        }
      ]
