                    { "time": "上午9点30分至10点", "children": [{ "text": "抵达科雷拉保护区，参观游客中心展览" }] },
                    { "time": "上午10点至10点40分", "children": [{ "text": "跟随向导观察林间小道并拍照" }] },
                    { "time": "上午10点40分", "children": [{ "text": "在纪念品店和休息区休息" }] },
                    { "time": "上午11点", "children": [{ "text": "前往罗博克河午餐游船" }] }
                  ]
                }
              ]
            },
            {
              "title": "一日联游行程",
              "blocks": [
                {
                  "type": "stepper",
                  "items": [
                    { "time": "上午", "children": [{ "text": "血盟纪念碑、巴克拉永教堂、眼镜猴保护区" }] },
                    { "time": "午餐", "children": [{ "text": "罗博克河游船" }] },
                    { "time": "下午", "children": [{ "text": "穿过比拉尔桃花心木林，前往巧克力山观景台与全地形车体验" }] }
                  ]
                }
              ]
            }
          ]
