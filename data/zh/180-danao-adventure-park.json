            { "label": "巨型秋千", "price": "约₱500~800", "note": "1人·2人" },
            { "label": "皮划艇·浮圈漂流·洞穴探险", "price": "约₱200~550", "note": "每人，视路线而定" },
            { "label": "塔比拉兰–达瑙巴士·小巴", "price": "约₱80~200", "note": "单程，2小时30分钟~3小时" },
            { "label": "包车", "price": "约₱3,000~4,500", "note": "每车，邦劳·塔比拉兰出发一日" },
            { "label": "餐食", "price": "约₱150~400", "note": "每人每餐，园内咖啡馆" }
          ]
        },
        {
