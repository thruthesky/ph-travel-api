            { "label": "耶稣掌心", "price": "免费至小额", "note": "停车费·捐款另计" },
            { "label": "哈布哈布炒面", "price": "每份约₱30–60", "note": "以香蕉叶盛装" },
            { "label": "餐厅用餐", "price": "每人约₱200–450", "note": "乡土美食餐厅" },
