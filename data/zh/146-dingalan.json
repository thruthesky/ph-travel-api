                    { "time": "08:00~10:30", "children": [{ "text": "瀑布游泳与休息" }] },
                    { "time": "11:30", "children": [{ "text": "午餐后退房" }] },
                    { "time": "12:30", "children": [{ "text": "搭乘开往卡瓦纳图安的客运面包车或巴士（请提前确认末班车时间）" }] },
                    { "time": "19:00", "children": [{ "text": "抵达马尼拉" }] }
