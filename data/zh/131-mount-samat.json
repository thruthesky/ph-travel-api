            { "label": "巴朗加–迪瓦吉普尼", "price": "单程约₱20–40", "note": "巴加克方向" },
            { "label": "三轮摩托车包车往返", "price": "每辆约₱300–500", "note": "含等候时间，需协商" },
            { "label": "圣地门票", "price": "每人约₱30–50", "note": "学生·儿童优惠，请确认最新公告" },
            { "label": "十字架观景回廊", "price": "运营时另计费", "note": "请确认是否因维修停运" },
            { "label": "巴朗加住宿", "price": "每晚约₱1,500–4,000", "note": "以市区酒店为准" },
            { "label": "餐食", "price": "每餐约₱150–400", "note": "以巴朗加餐厅为准" },
            { "label": "马尼拉出发包车", "price": "每天约₱4,500–7,000", "note": "含司机·油费，过路费另计" }
          ]
        },
        {
          "type": "caption",
          "children": [
            { "text": "以上价格为" },
