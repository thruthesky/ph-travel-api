            { "label": "阿克安博物馆", "price": "约₱50", "note": "外国人票价可能另计" },
            { "label": "三轮摩托车", "price": "每次约₱15~100", "note": "视合乘·包车而定" },
            { "label": "住宿", "price": "每晚约₱1,200~4,000", "note": "节庆期间大幅上涨" },
            { "label": "餐食", "price": "每餐约₱150~400", "note": "以当地餐厅为准" },
            { "label": "皮纳织品", "price": "约₱300~3,000", "note": "视尺寸·纤维比例而定" }
          ]
        },
        {
