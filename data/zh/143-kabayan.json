            { "label": "廷巴克洞穴包车", "price": "往返约₱2,500~5,000", "note": "以每辆车为准，可多人分摊" },
            { "label": "访客登记·门票", "price": "每处约₱30~100", "note": "可能变动，请以最新公告为准" },
            { "label": "洞穴管理员·向导", "price": "每队约₱300~800", "note": "依洞穴·距离而定" },
            { "label": "住宿", "price": "每晚约₱500~1,500", "note": "镇上旅馆·民宿" },
