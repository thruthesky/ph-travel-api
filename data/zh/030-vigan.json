                        { "type": "date", "text": "1807年" },
                        { "text": "巴西酒起义的画作（国家文化财产），免费，周一闭馆" }
                      ]
                    },
                    { "time": "11:00", "children": [{ "text": "逛阿贝尔伊罗戈（伊罗戈传统织物）店与纪念品" }] },
                    { "time": "12:00", "children": [{ "text": "午餐后前往拉瓦格、保埃方向，或搭乘返回马尼拉的巴士" }] }
                  ]
                }
              ]
            },
            {
              "title": "半天行程",
