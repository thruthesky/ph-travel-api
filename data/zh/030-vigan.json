                    { "time": "09:00", "children": [{ "text": "漫步克里索洛戈街、购买纪念品，参观克里索洛戈博物馆（捐款入场）" }] },
                    { "time": "10:30~11:30", "children": [{ "text": "乘卡莱萨游览帕格布尔纳扬陶艺工坊和西基亚公馆" }] },
                    { "time": "11:30", "children": [{ "text": "在布尔戈斯广场以恩潘纳达作午餐，然后出发前往下一个目的地" }] }
                  ]
                }
              ]
            }
          ]
        }
      ]
