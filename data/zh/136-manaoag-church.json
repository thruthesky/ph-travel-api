          "blocks": [
            {
              "type": "card",
              "title": "百岛国家公园",
              "place": "hundred-islands",
              "children": [
                { "text": "车程约" },
                { "type": "duration", "text": "1小时30分钟~2小时" },
                { "text": "，是游览阿拉米诺斯外海百余座岛屿的跳岛游胜地。" }
              ]
            },
            {
              "type": "card",
              "title": "碧瑶",
              "place": "baguio",
              "children": [
                { "text": "车程约" },
                { "type": "duration", "text": "2~2小时30分钟" },
                { "text": "，是拥有松树林和凉爽气候的高原城市。" }
              ]
            },
            {
              "type": "card",
              "title": "博利瑙",
              "place": "bolinao",
              "children": [
                { "text": "车程约" },
                { "type": "duration", "text": "2小时30分钟~3小时" },
                { "text": "，是班诗兰最西端的海边小镇，拥有礁岩海滩、灯塔与洞穴。" }
              ]
            },
            {
              "type": "card",
              "title": "圣胡安（拉乌尼翁）",
              "place": "san-juan-la-union",
              "children": [
                { "text": "车程约" },
                { "type": "duration", "text": "2~2小时30分钟" },
                { "text": "，拥有吕宋北部代表性的冲浪海滩与咖啡馆街。" }
              ]
            }
          ]
        }
      ]
