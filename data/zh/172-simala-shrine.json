            { "label": "宿务市–西邦加巴士", "price": "约₱80~130（单程）", "note": "Ceres巴士·小巴" },
            { "label": "habal-habal", "price": "每人约₱30~60（单程）", "note": "岔路口–圣殿入口" },
            { "label": "包车", "price": "每日约₱3,000~5,000", "note": "含司机，可多人分摊" },
