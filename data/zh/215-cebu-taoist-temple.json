          "items": [
            { "label": "寺庙门票", "price": "免费", "note": "非信徒也可入内，香火钱随意" },
            { "label": "香、蜡烛等供奉", "price": "约₱20~100", "note": "在入口商店购买，随意" },
            { "label": "市区-寺庙Grab·出租车", "price": "约₱150~300", "note": "单程，随交通状况变动" },
            { "label": "吉普尼", "price": "约₱10~15", "note": "拉乎格·苏德隆方向单程" },
            { "label": "哈巴哈巴", "price": "约₱20~100", "note": "从吉普尼下车处上山，需议价" },
            { "label": "停车", "price": "免费", "note": "车位有限" },
            { "label": "布赛山丘联游半日包车", "price": "约₱1,500~2,500", "note": "道教寺庙·利亚神殿·西劳花园" },
            { "label": "餐饮", "price": "约₱150~400", "note": "寺庙内没有餐厅，需在拉乎格一带解决" }
