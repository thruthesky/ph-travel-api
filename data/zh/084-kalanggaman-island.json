                { "type": "duration", "text": "3~4小时" },
                { "text": "（塔克洛班）。是连接莱特与萨马的红色钢拱海峡大桥。" }
              ]
            },
            {
              "type": "card",
              "title": "马拉帕斯卡岛",
              "place": "malapascua",
