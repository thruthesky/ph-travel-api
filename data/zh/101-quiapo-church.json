                { "text": "，可参观西班牙殖民时代的城墙古城与圣奥古斯丁教堂。" }
              ]
            },
            {
              "type": "card",
              "title": "菲律宾国家博物馆",
              "place": "national-museum",
              "children": [
                { "text": "搭Grab约" },
                { "type": "duration", "text": "15~25分钟" },
                { "text": "，是可免费参观菲律宾美术、人类学与自然史展览的博物馆群。" }
              ]
            }
          ]
        }
      ]
    }
