                    { "time": "中午12点30分", "children": [{ "text": "享用度假村午餐" }] },
                    { "time": "下午2点", "children": [{ "text": "无边泳池休息，环岛散步" }] },
                    { "time": "下午3点至4点", "children": [{ "text": "搭乘末班船返回本岛" }] }
                  ]
