                        { "text": "）" }
                      ]
                    },
                    { "time": "上午9点30分", "children": [{ "text": "沙洲散步、拍照与海水浴" }] },
                    { "time": "上午11点", "children": [{ "text": "浮潜或环岛散步" }] },
                    { "time": "中午12点30分", "children": [{ "text": "在度假村餐厅或本岛餐厅享用午餐" }] },
                    { "time": "下午1点30分", "children": [{ "text": "返回本岛后前往图马洛克瀑布或宿务市方向" }] }
                  ]
