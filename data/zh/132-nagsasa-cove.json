          "items": [
            { "label": "马尼拉–圣安东尼奥巴士", "price": "单程约₱450–550", "note": "Victory Liner" },
            { "label": "圣安东尼奥–蓬达基特三轮摩托车", "price": "每辆约₱150–200", "note": "约15–20分钟" },
            { "label": "蓬达基特环境税", "price": "每人约₱20", "note": "乘船前缴纳" },
            { "label": "纳格萨萨门票", "price": "每人约₱70–150", "note": "视当日或留宿而定，请确认最新公告" },
            { "label": "船只往返（限纳格萨萨湾）", "price": "每艘约₱2,500–3,000", "note": "以最多4人为准" },
            { "label": "跳岛游", "price": "每艘约₱3,500–4,000", "note": "含阿纳旺因·卡马拉·卡波内斯" },
            { "label": "帐篷·小屋租借", "price": "约₱300~1,500", "note": "以1晚为准，视大小与设施而定" },
            { "label": "瀑布向导", "price": "每队约₱300", "note": "当地向导" },
