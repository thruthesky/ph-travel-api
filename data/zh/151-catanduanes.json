              ]
            },
            {
              "type": "card",
              "title": "卡拉莫安",
              "place": "caramoan",
              "children": [
                { "text": "隔海位于西侧南甘马粦省的石灰岩岛群，经陆路转乘船只约需" },
                { "type": "duration", "text": "6~8小时" },
                { "text": "，很适合纳入比科尔环游行程。" }
              ]
            }
          ]
        }
      ]
    }
  ]
