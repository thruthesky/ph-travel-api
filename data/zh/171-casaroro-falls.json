                { "text": "车程约" },
                { "type": "duration", "text": "1小时~1小时30分钟" },
                { "text": "，可在被原始森林环绕的双子火山口湖上体验皮划艇。" }
              ]
            },
            {
              "type": "card",
              "title": "阿波岛",
              "place": "apo-island",
              "children": [
                { "text": "从杜马格特南部马拉塔帕伊乘船约" },
                { "type": "duration", "text": "30~45分钟" },
                { "text": "，是可与海龟同游浮潜的海洋保护区。" }
              ]
            },
            {
              "type": "card",
              "title": "曼胡约德沙洲",
              "place": "manjuyod-sandbar",
              "children": [
                { "text": "从杜马格特向北车程约" },
                { "type": "duration", "text": "1小时" },
                { "text": "，是退潮时显露于海面中央的白色沙洲。" }
              ]
            },
            {
              "type": "card",
              "title": "锡基霍尔",
              "place": "siquijor",
              "children": [
                { "text": "从杜马格特港口乘船约" },
                { "type": "duration", "text": "1~2小时" },
                { "text": "，是拥有瀑布、海滩与神秘传说的岛屿。" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
