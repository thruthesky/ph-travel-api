          "columns": ["项目", "预估费用", "备注"],
          "items": [
            { "label": "A线拼团", "price": "约₱1,200~1,600", "note": "每人，含午餐、救生衣和浮潜装备" },
            { "label": "环境税（ETDF）", "price": "约₱400", "note": "每人，10天内有效，现金支付" },
            { "label": "大潟湖入场费", "price": "约₱200", "note": "每人，部分旅行社含在团费内" },
            { "label": "皮划艇租赁", "price": "约₱300~400", "note": "双人皮划艇1艘，部分旅行社包含" },
            { "label": "包船", "price": "约₱4,500~10,000", "note": "每艘，因船的大小和旅行社而异" },
            { "label": "水鞋、防水袋", "price": "约₱200~500", "note": "镇上商店有售，已有则不需要" },
            { "label": "行程当天合计", "price": "约₱2,000~2,800", "note": "拼团每人，含环境税、入场费和皮划艇" }
