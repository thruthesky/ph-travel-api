                        { "text": "）——请提前一天向运营商确认是否有早间行程" }
                      ]
                    },
                    { "time": "06:30", "children": [{ "text": "4x4吉普车之旅与滑沙——沙子尚凉、阳光柔和，拍出的照片很漂亮" }] },
                    { "time": "07:45", "children": [{ "text": "在拉巴斯村前的河口观看渔民的邦卡船" }] },
                    { "time": "08:30", "children": [{ "text": "回到市区，用龙加尼萨和蒜香饭享用伊罗戈式早餐" }] },
                    { "time": "10:00", "children": [{ "text": "正午酷热时段待在室内——北伊罗戈省博物馆（请确认开放时间）" }] },
                    { "time": "12:00", "children": [{ "text": "午餐后在住处休息，或前往保埃、巴塔克一带" }] }
                  ]
                }
              ]
            }
          ]
        }
      ]
