              "type": "card",
              "title": "塞布湖",
              "place": "lake-sebu",
              "children": [
                { "text": "从特博利市区驱车约" },
                { "type": "duration", "text": "40分钟~1小时" },
                { "text": "，是一座以特博利族文化、七重瀑布和滑索闻名的高原湖泊。" }
              ]
            },
            {
              "type": "card",
              "title": "桑托斯将军城",
              "place": "general-santos",
              "children": [
                { "text": "距特博利约" },
                { "type": "duration", "text": "2小时30分钟~3小时30分钟" },
                { "text": "，是以清晨鱼市和金枪鱼料理闻名的港口城市。" }
              ]
            },
            {
              "type": "card",
              "title": "古马萨海滩",
              "place": "gumasa-beach",
              "children": [
                { "text": "经桑托斯将军城约" },
                { "type": "duration", "text": "4~5小时" },
                { "text": "，是萨兰加尼一处适合徒步后休整的白沙滩。" }
              ]
            },
            {
              "type": "card",
              "title": "达沃市",
              "place": "davao-city",
              "children": [
                { "text": "经科罗纳达尔、迪戈斯乘巴士约" },
                { "type": "duration", "text": "5~6小时" },
                { "text": "，是棉兰老岛最大的城市。" }
              ]
            }
          ]
        }
      ]
    }
  ]
